-pub(in super::super) fn spread(values: &[f64]) -> Option<f64> {
-    if values.is_empty() {
-        return None;
-    }
-    let min = values.iter().copied().reduce(f64::min)?;
-    let max = values.iter().copied().reduce(f64::max)?;
-    Some(max - min)
-}
