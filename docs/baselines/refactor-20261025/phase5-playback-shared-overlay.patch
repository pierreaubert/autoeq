+    #[test]
+    fn final_gain_records_keep_routed_input_and_output_ownership() {
+        let mut graph = crate::test_fixtures::single_channel_room_result("L").to_dsp_chain_output();
+        for (name, db, stage) in [
+            ("L", -2.0, "pre_route"),
