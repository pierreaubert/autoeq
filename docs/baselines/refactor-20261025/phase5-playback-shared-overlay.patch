-        .as_ref()
-        .ok()
-        .filter(|report| report.phase_source == PhaseSourceVerdict::Supported)
-        .and_then(|report| report.valid_lower_hz.zip(report.valid_upper_hz))
-        .map_or(evidence.valid_band_hz, |(lo, hi)| [lo, hi]);
