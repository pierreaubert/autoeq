-        return sub_output_limiter::sub_outputs(result);
-    }
-    crate::electrical_headroom::independent_graph_output_ports(&result.channels)
-        .into_iter()
-        .filter(|((channel, _), _)| super::super::misc::is_subwoofer_channel(config, channel))
