+//! Transactional selection of a complete delivered correction.
+//!
+//! Every trial starts from the same serialized graph. Electrical attenuation
+//! participates in acoustic replay; it is never normalized into the baseline.
+use super::*;
+use roomeq_model::PluginConfigWrapper;
+mod attenuation_budget;
+mod epa;
+mod joint_drive;
+mod kautz;
+mod physical_drive;
+mod sub_output_limiter;
+
+pub fn assess_delivered_epa(
+    result: &mut RoomOptimizationResult,
+    config: &RoomConfig,
+) -> Vec<StageCheck> {
+    epa::assess(result, config)
+}
+
+/// A marginal identity is not unchanged playback when configured-reference
+/// replay still shows a finite response change. This only flags the safe
+/// fallback; it does not waive any playback safety or acceptance checks.
+fn configured_reference_changed(comparison: &roomeq_model::ConfiguredBaselineComparison) -> bool {
+    comparison.residuals.iter().any(|residual| {
+        residual.score.post_covers_baseline_grid
+            && (residual
+                .score
+                .improvement_db
+                .is_some_and(|difference| difference.is_finite() && difference.abs() > 1e-6)
+                // Relative-target scoring level-matches the candidate, so a
+                // pure broadband shift leaves no shape improvement; the
+                // recorded post-reference gain still proves playback changed.
+                || (residual.score.post_reference_gain_db.is_finite()
+                    && residual.score.post_reference_gain_db.abs() > 1e-6))
+    })
+}
+
+/// Whether the delivered baseline already sits below every improvement
+/// floor, so no candidate could demonstrate meaningful improvement and
+/// unchanged playback is an approval rather than a failed correction.
+/// Mirrors the selection gates on both judging planes: the mean training
+/// improvement cannot exceed the mean configured baseline error, each
+/// seat's improvement cannot exceed that seat's baseline error, and the
+/// candidate-plane target error bounds any whole-playback improvement.
+fn configured_baseline_below_improvement_floors(
+    report: &roomeq_model::CorrectionAcceptanceReport,
+    policy: &roomeq_model::FinalizationConfig,
+) -> bool {
+    let primary_floor = policy.min_primary_improvement_db.max(1e-6);
+    if !report.metrics.pre_target_weighted_rms_db.is_finite()
+        || report.metrics.pre_target_weighted_rms_db > primary_floor
+    {
+        return false;
+    }
+    let Some(comparison) = report
+        .acoustic_quality
+        .as_ref()
+        .and_then(|quality| quality.training.configured_baseline.as_ref())
+    else {
+        return false;
+    };
+    if comparison.residuals.is_empty()
+        || comparison
+            .residuals
+            .iter()
+            .any(|residual| !residual.score.pre_weighted_rms_db.is_finite())
+    {
+        return false;
+    }
+    let mean_pre = comparison
+        .residuals
+        .iter()
+        .map(|residual| residual.score.pre_weighted_rms_db)
+        .sum::<f64>()
+        / comparison.residuals.len() as f64;
+    mean_pre <= primary_floor
+        || comparison.residuals.iter().all(|residual| {
+            residual.score.pre_weighted_rms_db <= policy.min_improvement_lower_bound_db
+        })
+}
