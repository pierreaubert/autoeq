+/// Load one CSV measurement curve with a workflow-level diagnostic.
+pub fn load_curve_from_csv(path: &Path) -> Result<Curve> {
+    load_curve_from_csv_with_frequency_samples(path, DEFAULT_FREQUENCY_SAMPLES)
+}
