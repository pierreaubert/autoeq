-/// Reference graph transfer plus independently calculated common backend latency.
-fn reference_transfer(
-    graph: &DspGraph,
-    sample_rate: f64,
-    frequencies: &[f64],
-    ir_registry: &HashMap<String, Vec<f64>>,
-) -> HashMap<String, HashMap<String, Vec<Complex64>>> {
