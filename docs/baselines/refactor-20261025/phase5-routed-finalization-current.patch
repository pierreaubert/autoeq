-    let routed = result
-        .metadata
-        .bass_management
-        .as_ref()
-        .and_then(|bass| bass.routing_graph.as_ref())
-        .is_some();
-    let independent = crate::electrical_headroom::independent_graph_output_ports(&result.channels);
-    for (output, attenuation) in required {
