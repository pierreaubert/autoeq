+"""Check actual Cargo archive file lists for every publishable workspace owner."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+REJECTED_ROOTS = ("data_tests/", "data_generated/", "scripts/")
+REJECTED_SUFFIXES = (".mdat", "~")
+
+
+def forbidden_path(path: str) -> bool:
+    normalized = path.replace("\\", "/")
+    return normalized.startswith(REJECTED_ROOTS) or normalized.endswith(REJECTED_SUFFIXES)
+
+
+def audit_packages(workspace: Path, cargo: str, *, run=subprocess.run) -> dict:
+    report = {"status": "failed", "workspace": str(workspace), "packages": [], "unpublished": []}
+    metadata_command = [cargo, "metadata", "--no-deps", "--offline", "--locked", "--format-version", "1"]
+    metadata = run(metadata_command, cwd=workspace, capture_output=True, text=True)
+    if metadata.returncode:
+        report["error"] = "Cargo metadata failed: " + metadata.stderr.strip()
+        return report
+    try:
+        graph = json.loads(metadata.stdout)
+        members = set(graph["workspace_members"])
+        packages = [p for p in graph["packages"] if p["id"] in members]
+        if {p["id"] for p in packages} != members:
+            raise ValueError("Cargo metadata omitted workspace members")
+    except (KeyError, TypeError, ValueError) as error:
+        report["error"] = "Invalid Cargo metadata: " + str(error)
+        return report
+    publishable = sorted((p for p in packages if p.get("publish") != []), key=lambda p: p["name"])
+    report["unpublished"] = sorted(p["name"] for p in packages if p.get("publish") == [])
+    if not publishable:
+        report["error"] = "No publishable workspace owners were checked"
+        return report
+    for package in publishable:
+        command = [cargo, "package", "--package", package["name"], "--list", "--allow-dirty", "--no-verify", "--offline", "--locked"]
+        result = run(command, cwd=workspace, capture_output=True, text=True)
+        files = result.stdout.splitlines()
+        leaked = [p for p in files if forbidden_path(p)]
+        report["packages"].append({
+            "name": package["name"], "version": package["version"], "command": command,
+            "exit_code": result.returncode, "files": files, "leaked": leaked,
+            "stderr": result.stderr, "passed": result.returncode == 0 and "Cargo.toml" in files and not leaked,
+        })
+    report["status"] = "passed" if all(p["passed"] for p in report["packages"]) else "failed"
+    return report
+
+
+def main(argv=None, *, run=subprocess.run) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--workspace", type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument("--cargo", default=os.environ.get("CARGO", "cargo"))
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args(argv)
+    try:
+        report = audit_packages(args.workspace.resolve(), args.cargo, run=run)
+    except OSError as error:
+        report = {"status": "failed", "packages": [], "error": str(error)}
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
+    if report["status"] != "passed":
+        print(report.get("error", "Cargo archive-content policy failed"), file=sys.stderr)
+        for package in report["packages"]:
+            if not package["passed"]:
+                print(f"{package['name']}: exit={package['exit_code']}; files={len(package['files'])}; leaked={package['leaked']}; {package['stderr'].strip()}", file=sys.stderr)
+        return 1
+    count = len(report["packages"])
+    print(f"Cargo archive contents pass for {count} publishable owners; {len(report['unpublished'])} owners remain unpublished.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
