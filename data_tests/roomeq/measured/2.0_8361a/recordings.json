{
  "version": "2.1.0",
  "speakers": {
    "L": {
      "path": "L.csv",
      "name": "L"
    },
    "R": {
      "path": "R.csv",
      "name": "R"
    }
  },
  "optimizer": {
    "algorithm": "autoeq:cmaes",
    "population": 21,
    "max_iter": 500000,
    "loss_type": "flat",
    "min_freq": 20.0,
    "max_freq": 16000.0,
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 3.0,
    "min_db": -12.0,
    "max_db": 4.0,
    "psychoacoustic": true,
    "asymmetric_loss": true,
    "phase_alignment": {
      "enabled": true,
      "min_freq": 30.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    },
    "inter_channel_timbre_matching": {
      "enabled": true,
      "reference_channel": "L",
      "min_improvement_db": 0.05
    }
  }
}
