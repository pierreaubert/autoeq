-        // Rear (Inverted + Delayed)
-        let r_mag = 10.0_f64.powf(rear_curve.spl[i] / 20.0);
-        let r_phi_meas = rear_phase[i].to_radians();
-        let delay_s = delay_ms / 1000.0;
-        let delay_phi = -omega * delay_s;
-        let invert_phi = std::f64::consts::PI;
