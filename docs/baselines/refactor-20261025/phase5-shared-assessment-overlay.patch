-    // impulse response at that reference microphone, before and after the
-    // deployed correction, instead of reporting the view unavailable.
-    let waveform_basis: std::collections::BTreeMap<String, autoeq_core::Curve> = result
-        .channel_results
-        .keys()
-        .filter_map(|name| {
-            // Channel results are keyed by role ("L"), speaker configs by
-            // speaker key ("left"): resolve through the system mapping or
-            // every mapped config silently loses its waveform basis.
-            let source = crate::evidence_intake::resolve_channel_source(config, name)?;
