{
  "version": "1.2.0",
  "system": {
    "model": "stereo",
    "speakers": {
      "L": "left",
      "R": "right"
    }
  },
  "speakers": {
    "right": {
      "name": "right_group",
      "measurements": [
        {
          "measurements": [
            "right_lp0.csv",
            "right_lp1.csv",
            "right_lp2.csv",
            "right_lp3.csv",
            "right_lp4.csv"
          ]
        },
        {
          "measurements": [
            "right_sub_lp0.csv",
            "right_sub_lp1.csv",
            "right_sub_lp2.csv",
            "right_sub_lp3.csv",
            "right_sub_lp4.csv"
          ]
        }
      ],
      "crossover": "first"
    },
    "left": {
      "name": "left_group",
      "measurements": [
        {
          "measurements": [
            "left_lp0.csv",
            "left_lp1.csv",
            "left_lp2.csv",
            "left_lp3.csv",
            "left_lp4.csv"
          ]
        },
        {
          "measurements": [
            "left_sub_lp0.csv",
            "left_sub_lp1.csv",
            "left_sub_lp2.csv",
            "left_sub_lp3.csv",
            "left_sub_lp4.csv"
          ]
        }
      ],
      "crossover": "first"
    }
  },
  "crossovers": {
    "first": {
      "type": "LR24",
      "frequency": 80.0
    }
  },
  "optimizer": {
    "processing_mode": "low_latency",
    "loss_type": "flat",
    "algorithm": "autoeq:de",
    "strategy": "currenttobest1bin",
    "num_filters": 7,
    "min_filter_improvement": 0.01,
    "elimination_threshold": 0.01,
    "min_q": 0.5,
    "max_q": 10.0,
    "min_db": -12.0,
    "max_db": 12.0,
    "min_freq": 20.0,
    "max_freq": 999.9999999999998,
    "max_iter": 5000,
    "population": 30,
    "peq_model": "pk",
    "seed": 42,
    "refine": true,
    "asymmetric_loss": true,
    "smooth_n": 3,
    "multi_measurement": {
      "strategy": "minimax",
      "variance_lambda": 1.0
    }
  }
}