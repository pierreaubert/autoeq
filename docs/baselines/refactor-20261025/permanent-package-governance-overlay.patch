+"""Functional controls for Cargo archive membership and failure handling."""
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+from scripts.check_package_contents import main
+
+
+class CargoBoundary:
+    def __init__(self, *, files=None, package_exit=0, metadata_exit=0):
+        self.files = ["Cargo.toml", "src/lib.rs"] if files is None else files
+        self.package_exit = package_exit
+        self.metadata_exit = metadata_exit
+        self.checked = []
+
+    def __call__(self, command, **kwargs):
+        if command[1] == "metadata":
+            packages = [
+                {"id": "a", "name": "library-a", "version": "1.0.0", "publish": None},
+                {"id": "b", "name": "library-b", "version": "1.0.0", "publish": ["private"]},
+                {"id": "t", "name": "terminal", "version": "1.0.0", "publish": []},
+                {"id": "external", "name": "non-member", "version": "1.0.0", "publish": None},
+            ]
+            return SimpleNamespace(returncode=self.metadata_exit, stdout=json.dumps({"workspace_members": ["a", "b", "t"], "packages": packages}), stderr="metadata refusal" if self.metadata_exit else "")
+        if command[1] != "package":
+            raise AssertionError(command)
+        name = command[command.index("--package") + 1]
+        if name not in {"library-a", "library-b"}:
+            raise AssertionError("unpublished or non-member archive was requested: " + name)
+        self.checked.append(name)
+        return SimpleNamespace(returncode=self.package_exit, stdout="\n".join(self.files), stderr="package refusal" if self.package_exit else "")
+
+
+class PackageContentsTests(unittest.TestCase):
+    def invoke(self, boundary):
+        parent = Path("/Volumes/home_tmp/tmp")
+        with tempfile.TemporaryDirectory(prefix="autoeq package policy ", dir=parent if parent.is_dir() else None) as directory:
+            root = Path(directory)
+            (root / "Cargo.toml").write_text("[workspace]\nmembers=[]\n")
+            output = root / "audit result.json"
+            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+                code = main(["--workspace", str(root), "--cargo", "/a cargo path with spaces/cargo", "--output", str(output)], run=boundary)
+            return code, json.loads(output.read_text())
+
+    def test_all_publishable_members_checked_and_terminal_excluded(self):
+        boundary = CargoBoundary()
+        code, report = self.invoke(boundary)
+        self.assertEqual(code, 0)
+        self.assertEqual(report["status"], "passed")
+        self.assertEqual(boundary.checked, ["library-a", "library-b"])
+        self.assertEqual(report["unpublished"], ["terminal"])
+        self.assertTrue(all(p["command"][0] == "/a cargo path with spaces/cargo" for p in report["packages"]))
+
+    def test_qa_scripts_backups_and_measurements_cannot_leak(self):
+        for path in ["data_tests/raw.csv", "data_generated/out.json", "scripts/helper.py", "measurement.mdat", "src/lib.rs~", r"scripts\helper.py"]:
+            with self.subTest(path=path):
+                code, report = self.invoke(CargoBoundary(files=["Cargo.toml", path]))
+                self.assertEqual(code, 1)
+                self.assertEqual(report["status"], "failed")
+                self.assertTrue(all(p["leaked"] == [path] for p in report["packages"]))
+
+    def test_empty_lists_and_cargo_failures_cannot_report_success(self):
+        for boundary in [CargoBoundary(files=[]), CargoBoundary(files=[""]), CargoBoundary(files=["usage: cargo package"]), CargoBoundary(package_exit=17), CargoBoundary(metadata_exit=19)]:
+            with self.subTest(package_exit=boundary.package_exit, metadata_exit=boundary.metadata_exit, files=boundary.files):
+                code, report = self.invoke(boundary)
+                self.assertEqual(code, 1)
+                self.assertEqual(report["status"], "failed")
+
+
+if __name__ == "__main__":
+    unittest.main()
