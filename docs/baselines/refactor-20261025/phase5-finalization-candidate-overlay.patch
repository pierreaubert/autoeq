+                );
+            } else {
+                assert_eq!(
+                    report.outcome,
+                    roomeq_model::RoomEqOutcome::Unchanged,
+                    "{report:?}"
+                );
+                assert!(
+                    result.channels["L"].plugins.iter().all(|plugin| {
