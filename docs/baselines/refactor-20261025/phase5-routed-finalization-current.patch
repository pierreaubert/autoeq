-#[derive(Debug, Clone)]
-pub(super) enum JointTrial {
-    Gain(Vec<GainTrim>),
-    Delay {
-        channel: String,
-        driver_index: usize,
-        target_ms: f64,
-        additions_ms: Vec<(usize, f64)>,
