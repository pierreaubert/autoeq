+//! Fresh configured native acceptance without changing the deployed graph.
+
+use super::{group_delay_budget_ms, retained_fir_coeffs_by_channel, room_optimization_result, RoomOptimizationResult};
+use roomeq_model::{AutoeqError, Result, RoomConfig, StageOutcome, StageStatus};
+use std::path::Path;
+
+pub fn configured_acceptance_graph(value: &RoomOptimizationResult) -> serde_json::Value {
+    serde_json::to_value((
+        &value.channels,
+        value.to_dsp_chain_output().global_plugins,
+        &value.metadata.bass_management,
+        &value.metadata.ctc,
+        &value.deployed_source_curves,
+        retained_fir_coeffs_by_channel(value),
+    ))
+    .expect("serializable deployed graph")
+}
+
+pub fn refresh_configured_native_acceptance(
+    result: &mut RoomOptimizationResult,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+) -> Result<()> {
+    let previous = result.metadata.correction_acceptance.clone();
+    let before = configured_acceptance_graph(result);
+    let mut replay = result.clone();
+    replay.metadata.correction_acceptance = None;
+    room_optimization_result::apply_final_correction_safety_gate(
+        &mut replay,
+        fs,
+        config.optimizer.smooth_n,
+        (config.optimizer.min_freq, config.optimizer.max_freq),
+        dir,
+        config.optimizer.processing_mode.clone(),
+        group_delay_budget_ms(config),
+    );
+    let after = configured_acceptance_graph(&replay);
+    if after != before {
+        let changed_channels: Vec<_> = before[0]
+            .as_object()
+            .into_iter()
+            .flatten()
+            .filter_map(|(name, chain)| {
+                let fields: Vec<_> = chain
+                    .as_object()
+                    .into_iter()
+                    .flatten()
+                    .filter(|(field, value)| after[0][name][field] != **value)
+                    .map(|(field, _)| field.as_str())
+                    .collect();
+                (!fields.is_empty()).then_some((name, fields))
+            })
+            .collect();
+        return Err(failed(format!(
+            "fresh configured acceptance would change the candidate graph: channels={changed_channels:?}; routing_changed={}; sources_changed={}; coefficients_changed={}",
+            before[2] != after[2],
+            before[4] != after[4],
+            before[5] != after[5]
+        )));
+    }
+    let mut report = replay
+        .metadata
+        .correction_acceptance
+        .ok_or_else(|| failed("fresh configured native acceptance evidence unavailable"))?;
+    if let Some(previous) = previous {
+        if let Some(policy) = previous.runtime_policy {
+            let policy = room_optimization_result::policy_for_delivered_graph(result, policy);
+            let quality = report
+                .acoustic_quality
+                .clone()
+                .ok_or_else(|| failed("fresh preserved-policy acoustic evidence unavailable"))?;
+            let realization = report
+                .realization_quality
+                .clone()
+                .ok_or_else(|| failed("fresh preserved-policy realization evidence unavailable"))?;
+            roomeq_quality::enforce_runtime_acceptance_evidence(
+                &mut report,
+                quality,
+                realization,
+                policy,
+            )
+            .map_err(failed)?;
+        }
+        if !previous.violations.is_empty() {
+            result.metadata.stage_outcomes.push(StageOutcome {
+                stage: "previous_graph_acceptance_history".into(),
+                status: StageStatus::Skipped,
+                advisories: previous.violations,
+                checks: Vec::new(),
+            });
+        }
+    }
+    result.metadata.correction_acceptance = Some(report);
+    Ok(())
+}
+
+fn failed(message: impl Into<String>) -> AutoeqError {
+    AutoeqError::OptimizationFailed {
+        message: message.into(),
+    }
+}
