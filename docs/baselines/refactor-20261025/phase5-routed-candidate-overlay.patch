-            message: "Cardioid measurements lack common frequency support".into(),
-        })?;
-    let front_curve = autoeq_core::interpolate_log_space(&grid, &front_curve);
-    let rear_curve = autoeq_core::interpolate_log_space(&grid, &rear_curve);
