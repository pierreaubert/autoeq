+        deployed_source_curves = match first_replay {
+            Ok(curves) => curves,
+            Err(first_error)
+                if channel_chains.values().any(|chain| {
+                    chain.plugins.iter().any(|plugin| {
+                        plugin
+                            .parameters
+                            .get("label")
+                            .and_then(serde_json::Value::as_str)
