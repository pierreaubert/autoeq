-    if choose_configured {
-        *result = configured?;
-    } else {
-        structural_attempt?;
-        *result = structural;
-    }
-    if let Some(stage) = result
-        .metadata
-        .stage_outcomes
-        .iter_mut()
-        .rev()
-        .find(|stage| stage.stage == "final_correction_selection")
-    {
