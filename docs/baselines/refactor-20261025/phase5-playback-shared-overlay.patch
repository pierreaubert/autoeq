-            .collect::<Result<_, _>>()
-            .map_err(|error| format!("Failed to decode WAV '{}': {error}", path.display()))?,
-        hound::SampleFormat::Int => {
-            let full_scale = 1_i64
-                .checked_shl(u32::from(spec.bits_per_sample - 1))
