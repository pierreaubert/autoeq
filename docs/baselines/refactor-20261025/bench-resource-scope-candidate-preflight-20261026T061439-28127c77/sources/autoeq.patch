-/// Convert frequency in Hz to Bark scale using Zwicker's formula.
-///
-/// z = 13 * arctan(0.00076 * f) + 3.5 * arctan((f / 7500)^2)
-pub fn hz_to_bark(f: f64) -> f64 {
-    13.0 * (0.00076 * f).atan() + 3.5 * ((f / 7500.0).powi(2)).atan()
-}
