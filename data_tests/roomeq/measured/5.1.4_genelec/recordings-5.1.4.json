{
  "version": "2.1.0",
  "system": {
    "model": "home_cinema",
    "speakers": {
      "L": "front_left_large",
      "R": "front_right_large",
      "LFE": "lfe_subwoofer",
      "C": "center_genelec",
      "SL": "side_left_genelec",
      "SR": "side_right_genelec",
      "TFL": "top_front_left",
      "TFR": "top_front_right",
      "TBL": "top_back_left",
      "TBR": "top_back_right"
    },
    "subwoofers": {
      "config": "single",
      "crossover": "bass_xover",
      "lfe_subwoofer": "L"
    }
  },
  "crossovers": {
    "bass_xover": {
      "type": "LR24",
      "frequency_range": [60.0, 120.0]
    }
  },
  "optimizer": {
    "loss_type": "flat",
    "min_freq": 20.0,
    "max_freq": 16000.0,
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 3.0,
    "min_db": -12.0,
    "max_db": 4.0,
    "psychoacoustic": true,
    "psychoacoustic_smoothing": {
      "low_freq_n": 48,
      "high_freq_n": 6,
      "low_freq": 100.0,
      "high_freq": 1000.0
    },
    "asymmetric_loss": true,
    "asymmetric_loss_config": {
      "peak_weight": 2.0,
      "dip_weight": 1.0,
      "bass_peak_weight": 5.0,
      "bass_dip_weight": 1.0,
      "transition_freq": 300.0
    },
    "high_frequency_correction": {
      "enabled": true,
      "start_hz": 1600.0,
      "extra_deadband_db": 0.75,
      "smoothing_n": 3,
      "max_q": 2.0
    },
    "excursion_protection": {
      "enabled": true,
      "auto_detect_f3": true,
      "f3_reference_min_hz": 100.0,
      "f3_reference_max_hz": 200.0,
      "filter_type": "linkwitzriley",
      "filter_order": 4,
      "margin_octaves": 0.25
    },
    "schroeder_split": {
      "enabled": true,
      "schroeder_freq": 300.0,
      "low_freq_config": {
        "min_q": 0.5,
        "max_q": 5.0,
        "allow_boost": false
      },
      "high_freq_config": {
        "max_q": 1.0,
        "shelving_only": false
      }
    },
    "phase_alignment": {
      "enabled": true,
      "min_freq": 50.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    },
    "inter_channel_timbre_matching": {
      "enabled": true,
      "reference_channel": "C",
      "min_improvement_db": 0.05
    },
    "height_channel_alignment": {
      "enabled": true,
      "match_timbre": true,
      "match_level": true,
      "match_arrival_time": true,
      "match_phase": false,
      "min_timbre_improvement_db": 0.05,
      "max_delay_ms": 20.0,
      "reference_channels": {
        "top_front": "L",
        "top_rear": "SL"
      }
    }
  },
  "speakers": {
    "front_left_large": {
      "path": "l.csv",
      "name": "Genelec 8361A"
    },
    "front_right_large": {
      "path": "r.csv",
      "name": "Genelec 8361A"
    },
    "lfe_subwoofer": {
      "path": "lfe.csv",
      "name": "Genelec 7370A"
    },
    "center_genelec": {
      "path": "c.csv",
      "name": "Genelec 8341A"
    },
    "side_left_genelec": {
      "path": "sl.csv",
      "name": "Genelec 8341A"
    },
    "side_right_genelec": {
      "path": "sr.csv",
      "name": "Genelec 8341A"
    },
    "top_front_left": {
      "path": "tfl.csv",
      "name": "Genelec 8330A"
    },
    "top_front_right": {
      "path": "tfr.csv",
      "name": "Genelec 8330A"
    },
    "top_back_left": {
      "path": "trl.csv",
      "name": "Genelec 8330A"
    },
    "top_back_right": {
      "path": "trr.csv",
      "name": "Genelec 8330A"
    }
  }
}
