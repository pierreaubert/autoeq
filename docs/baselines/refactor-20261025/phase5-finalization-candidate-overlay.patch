-        let mut kernels = std::collections::BTreeMap::new();
-        for (name, chain) in &result.channels {
-            let keep = |plugin: &&PluginConfigWrapper| {
-                plugin.plugin_type != "limiter"
-                    && plugin.parameters["label"].as_str() != Some("room_eq_limiter_latency")
-                    && plugin
-                        .parameters
