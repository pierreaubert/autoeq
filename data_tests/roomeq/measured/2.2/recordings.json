{
  "version": "2.1.0",
  "system": {
    "model": "stereo",
    "speakers": {
      "L": "L",
      "R": "R",
      "LFE": "subs"
    },
    "subwoofers": {
      "config": "mso",
      "crossover": "bass_xover",
      "subs": "L"
    }
  },
  "speakers": {
    "L": {
      "path": "L_No_EQ_Sep_1.csv",
      "name": "L No EQ Sep 1"
    },
    "R": {
      "path": "R_No_EQ_Sep_1.csv",
      "name": "R No EQ Sep 1"
    },
    "subs": {
      "name": "Two subs",
      "subwoofers": [
        {
          "path": "L_Sub_No_EQ_Sep_1.csv",
          "name": "Main listening position"
        },
        {
          "path": "R_Sub_No_EQ_Sep_1.csv",
          "name": "Main listening position"
        }
      ],
      "allpass_optimization": false
    }
  },
  "crossovers": {
    "bass_xover1": {
      "type": "LR24",
      "frequency_range": [40.0, 130.0]
    },
    "bass_xover2": {
      "type": "LR24",
      "frequency_range": [60.0, 130.0]
    }
  },
  "optimizer": {
    "algorithm": "autoeq:cmaes",
    "population": 21,
    "max_iter": 500000,
    "loss_type": "flat",
    "min_freq": 20.0,
    "max_freq": 16000.0,
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 3.0,
    "min_db": -12.0,
    "max_db": 4.0,
    "psychoacoustic": true,
    "asymmetric_loss": true,
    "phase_alignment": {
      "enabled": true,
      "min_freq": 30.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    }
  }
}
