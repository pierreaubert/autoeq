+    }
+    post_scores = channel_results
+        .values()
+        .map(|result| result.post_score)
+        .collect();
+
+    let avg_pre = pre_scores.iter().sum::<f64>() / pre_scores.len() as f64;
+    let avg_post = post_scores.iter().sum::<f64>() / post_scores.len() as f64;
