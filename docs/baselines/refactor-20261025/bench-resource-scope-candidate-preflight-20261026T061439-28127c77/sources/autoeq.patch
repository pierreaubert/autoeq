-        callback,
-    );
-
-    // Check that optimization succeeded
-    assert!(result.is_ok(), "Optimization should succeed: {:?}", result);
-
-    // Check that callback was invoked at least once
-    let count = *callback_count.lock().unwrap();
-    assert!(
