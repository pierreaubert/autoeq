+"""Preserve original RoomEQ coverage responsibility across mechanical owner moves."""
+from pathlib import Path
+import re
+
+ROOM_PACKAGES = ('roomeq-model', 'roomeq-analysis', 'roomeq-quality', 'roomeq-engine', 'roomeq-export', 'roomeq-workflow', 'roomeq-dsp')
+PACKAGES = (*ROOM_PACKAGES, 'autoeq-optim-types')
+ADDITIONAL_PACKAGES = ('roomeq-engine-channel', 'roomeq-engine-system', 'roomeq-workflow-contracts', 'roomeq-playback', 'roomeq-routed', 'roomeq-finalization')
+DUPLICATE_FIXTURES = ('crates/roomeq-playback/src/test_fixtures.rs', 'crates/roomeq-finalization/src/test_fixtures.rs')
+CANONICAL_FIXTURE = 'crates/roomeq-workflow/src/test_fixtures.rs'
+SOURCE_PATTERN = (r'/crates/(' + '|'.join((*ROOM_PACKAGES, *ADDITIONAL_PACKAGES)) + r')/src/.*\.rs$'
+                  r'|/crates/autoeq-optim-types/src/(?:lib|evidence|reference_registry)\.rs$')
+
+
+def included(filename):
+    filename = filename.replace('\\', '/')
+    return re.search(SOURCE_PATTERN, filename) is not None and not any(filename.endswith('/' + path) for path in DUPLICATE_FIXTURES)
+
+
+def selected_packages(names):
+    expected = set(ROOM_PACKAGES[:-1] if 'autoeq' in names else PACKAGES)
+    expected.update(set(ADDITIONAL_PACKAGES) & names)
+    known = set(PACKAGES) | set(ADDITIONAL_PACKAGES)
+    unexpected = {name for name in names if name.startswith('roomeq-')} - known - {'roomeq-cli', 'roomeq-qa', 'roomeq-synthetic'}
+    if names & known != expected or unexpected:
+        raise ValueError('unexpected coverage package ownership')
+    return tuple(name for name in (*PACKAGES, *ADDITIONAL_PACKAGES) if name in expected)
+
+
+def duplicate_fixtures(root):
+    present = [path for path in DUPLICATE_FIXTURES if (root / path).is_file()]
+    if not present:
+        return []
+    original = (root / CANONICAL_FIXTURE).read_bytes()
+    for path in [CANONICAL_FIXTURE, *present]:
+        if (root / path).read_bytes() != original:
+            raise ValueError('excluded fixture is not an exact canonical copy: ' + path)
+        lib = (root / path).with_name('lib.rs').read_text()
+        if not re.search(r'#\[cfg\(test\)\]\s*mod test_fixtures;', lib):
+            raise ValueError('fixture is not a test-only module: ' + path)
+    return present
+
+
+SUBSYSTEM_MOVES = {
+    'crates/roomeq-workflow/src/room_optimization/': (
+        'crates/roomeq-playback/src/assessment/',
+        'crates/roomeq-playback/src/level_alignment.rs',
+        'crates/roomeq-playback/src/physical_fir.rs',
+        'crates/roomeq-playback/src/parallel_timing.rs',
+        'crates/roomeq-finalization/src/room_optimization/',
+        'crates/roomeq-finalization/src/lib.rs',
+    ),
+    'crates/roomeq-workflow/src/topology/': (
+        'crates/roomeq-routed/src/topology/',
+        'crates/roomeq-routed/src/lib.rs',
+        'crates/roomeq-playback/src/routed.rs',
+    ),
+}
+
+
+def subsystem_matches(filename, prefix):
+    filename = '/' + filename.replace('\\', '/').lstrip('/')
+    for path in (prefix, *SUBSYSTEM_MOVES.get(prefix, ())):
+        if path.endswith('/'):
+            if '/' + path in filename or filename.endswith('/' + path.rstrip('/') + '.rs'):
+                return True
+        elif filename.endswith('/' + path):
+            return True
+    return False
+
+
+def original_owner(relative):
+    owner = relative.split('/')[1]
+    if owner in {'roomeq-engine-channel', 'roomeq-engine-system'}:
+        return 'crates/roomeq-engine/src/ (coordinator source map)'
+    if owner == 'roomeq-finalization':
+        return relative.replace('/roomeq-finalization/', '/roomeq-workflow/')
+    if owner == 'roomeq-routed':
+        return relative.replace('/roomeq-routed/', '/roomeq-workflow/') if '/topology/' in relative else 'crates/roomeq-workflow/src/ (application boundary source map)'
+    if owner == 'roomeq-workflow-contracts':
+        return 'crates/roomeq-workflow/src/ (pipeline and recovery contract source map)'
+    if owner == 'roomeq-playback':
+        if '/assessment' in relative:
+            return relative.replace('/roomeq-playback/src/assessment', '/roomeq-workflow/src/room_optimization')
+        if relative.endswith('/routed.rs'):
+            return 'crates/roomeq-workflow/src/topology/home_cinema.rs'
+        if '/final_ledger/snapshot.rs' in relative:
+            return 'crates/roomeq-workflow/src/final_ledger.rs'
+        if any(relative.endswith('/'+name+'.rs') for name in ('level_alignment', 'physical_fir', 'parallel_timing')):
+            return 'crates/roomeq-workflow/src/room_optimization/ (shared helper source map)'
+        return 'crates/roomeq-workflow/src/ (shared playback source map)'
+    return relative
