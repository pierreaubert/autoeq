-/// Compute a mixed loss based on flatness on lw and pir
-pub fn mixed_loss(
-    score_data: &SpeakerLossData,
-    freq: &Array1<f64>,
-    peq_response: &Array1<f64>,
-) -> f64 {
-    let lw2 = &score_data.lw + peq_response;
