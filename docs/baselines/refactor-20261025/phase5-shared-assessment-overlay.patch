-    let values: Vec<f64> = front_or_center
-        .iter()
-        .map(|channel| channel.final_arrival_ms)
-        .collect();
-    if spread(&values).unwrap_or(0.0) > 0.5 {
-        Some("lcr_imaging_timing_spread".to_string())
