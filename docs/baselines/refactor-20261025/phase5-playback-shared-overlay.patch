-            report.detail,
-            report.phase_source,
-            report.reflection_free_interval_s,
-            [report.valid_lower_hz, report.valid_upper_hz],
-            report.reason_codes,
-            evidence
-                .provenance
-                .direct_sound
-                .as_ref()
-                .and_then(|direct| direct.policy.as_ref()),
