-            gain.parameters["room_eq_stage"] = serde_json::json!("post_route");
-        }
-        let mut installed = false;
-        for (name, chain) in &mut result.channels {
-            if let Some(drivers) = &mut chain.drivers {
-                for driver in drivers {
-                    let matches = if routed {
