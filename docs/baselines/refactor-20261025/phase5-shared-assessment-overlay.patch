-            let target_measurement = if self.excursion.contains_key(input) {
-                measured(physical, input, seat)?
-            } else {
-                &pre.curve
-            };
-            let lfe_target = self
-                .lfe_target
-                .as_ref()
-                .map(|reference| reference.target(physical, input, seat, &context, resources))
-                .transpose()?
