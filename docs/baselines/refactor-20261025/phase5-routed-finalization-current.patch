-    let grid = &delivered[0].freq;
-    for (index, curve) in delivered.iter().enumerate() {
-        if !roomeq_analysis::frequency_grid::same_frequency_grid(grid, &curve.freq) {
-            return Err(format!("mono-bass input {index} leaves the common grid"));
