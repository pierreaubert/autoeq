-        let stage = plugin
-            .parameters
-            .get("room_eq_stage")
-            .and_then(serde_json::Value::as_str)?;
-        match stage {
-            "pre_route" | "post_route" if stage == owner => {
-                sum += plugin_gain_sum(plugin)?;
-            }
-            "pre_route" | "post_route" => {}
-            "route_owned"
-                if matches!(plugin.plugin_type.as_str(), "gain" | "delay" | "crossover") => {}
-            _ => return None,
-        }
-    }
-    Some(sum)
