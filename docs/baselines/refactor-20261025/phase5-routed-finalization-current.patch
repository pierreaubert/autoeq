+                    for frequency in [0.0, 25.0, 75.0, 100.0, 135.0, 200.0, 1000.0, fs / 2.0] {
+                        let unity = Complex64::new(1.0, 0.0);
+                        let expected =
+                            unity + strength * (before.response_at(frequency).unwrap() - unity);
+                        let actual = selected.response_at(frequency).unwrap();
