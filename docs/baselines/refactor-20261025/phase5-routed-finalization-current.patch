+            multi_config,
+            Some(&resources),
+            sample_rate,
+            callback,
+        ),
+        None => engine_eq::optimize_channel_eq_multi_detailed(
+            curves,
+            config,
+            multi_config,
+            Some(&resources),
+            sample_rate,
+        ),
+    }
+}
