+                gain.parameters["room_eq_stage"] = serde_json::json!("post_route");
+                gain.parameters["room_eq_correction_gain"] = serde_json::json!(true);
+                result.channels.get_mut(output).unwrap().plugins.push(gain);
+            }
+            let captures: Vec<_> = ["left", "sub"]
