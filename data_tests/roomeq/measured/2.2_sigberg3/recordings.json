{
  "version": "2.2.0",
  "system": {
    "model": "stereo",
    "speakers": {
      "L": "L",
      "R": "R"
    }
  },
  "speakers": {
    "L": {
      "name": "Left speaker and subwoofer",
      "drivers": [
        {
          "id": "left_sub",
          "role": "subwoofer",
          "measurement": "left_sub.csv"
        },
        {
          "id": "left_main",
          "role": "full_range",
          "measurement": "left.csv"
        }
      ],
      "crossover": "bass_xover1"
    },
    "R": {
      "name": "Right speaker and subwoofer",
      "drivers": [
        {
          "id": "right_sub",
          "role": "subwoofer",
          "measurement": "right_sub.csv"
        },
        {
          "id": "right_main",
          "role": "full_range",
          "measurement": "right.csv"
        }
      ],
      "crossover": "bass_xover2"
    }
  },
  "crossovers": {
    "bass_xover1": {
      "type": "LR24",
      "frequency_range": [40.0, 100.0]
    },
    "bass_xover2": {
      "type": "LR24",
      "frequency_range": [40.0, 100.0]
    }
  },
  "optimizer": {
    "algorithm": "autoeq:cmaes",
    "population": 14,
    "max_iter": 500000,
    "loss_type": "flat",
    "min_freq": 20.0,
    "max_freq": 200.0,
    "num_filters": 7,
    "min_q": 0.5,
    "max_q": 6.0,
    "min_db": -12.0,
    "max_db": 6.0,
    "psychoacoustic": true,
    "asymmetric_loss": true,
    "phase_alignment": {
      "enabled": true,
      "min_freq": 30.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    }
  }
}
