-pub(super) fn fir_complex_response(coeffs: &[f64], freq: f64, sample_rate: f64) -> Complex64 {
-    let w = 2.0 * PI * freq / sample_rate;
-    coeffs
-        .iter()
-        .enumerate()
-        .fold(Complex64::new(0.0, 0.0), |acc, (n, &coeff)| {
-            acc + Complex64::from_polar(coeff, -w * n as f64)
-        })
-}
