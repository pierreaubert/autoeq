{
  "version": "2.1.0",
  "system": {
    "model": "stereo",
    "speakers": {
      "L": "L",
      "R": "R",
      "LFE": "subs"
    },
    "subwoofers": {
      "config": "mso",
      "crossover": ["bass_xover1", "bass_xover2"],
      "subs": "L"
    }
  },
  "speakers": {
    "L": {
      "path": "l.csv",
      "name": "Left No EQ Sep 1"
    },
    "R": {
      "path": "r.csv",
      "name": "Right No EQ Sep 1"
    },
    "subs": {
      "name": "Two subs",
      "subwoofers": [
        {
          "path": "l_sub.csv",
          "name": "Left Sub"
        },
        {
          "path": "r_sub.csv",
          "name": "Right Sub"
        }
      ],
      "allpass_optimization": true
    }
  },
  "crossovers": {
    "bass_xover1": {
      "type": "LR24",
      "frequency_range": [40.0, 130.0]
    },
    "bass_xover2": {
      "type": "LR24",
      "frequency_range": [40.0, 130.0]
    }
  },
  "optimizer": {
    "algorithm": "autoeq:cmaes",
    "population": 14,
    "max_iter": 500000,
    "loss_type": "flat",
    "min_freq": 20.0,
    "max_freq": 16000.0,
    "num_filters": 16,
    "min_q": 0.5,
    "max_q": 6.0,
    "min_db": -12.0,
    "max_db": 6.0,
    "psychoacoustic": true,
    "asymmetric_loss": true,
    "phase_alignment": {
      "enabled": true,
      "min_freq": 30.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    }
  }
}
