-/// Separate physical-main SPL evidence from the combined source's bass quality.
-fn physical_main_quality(
-    result: &RoomOptimizationResult,
-    baseline: &RoomOptimizationResult,
-    physical: &BTreeMap<String, Vec<Curve>>,
-    input: &str,
