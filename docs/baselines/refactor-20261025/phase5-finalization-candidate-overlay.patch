-            limit: Some(FINAL_CHANNEL_LEVEL_TOLERANCE_DB),
-            passed: baseline_spread.is_finite()
-                && baseline_spread <= FINAL_CHANNEL_LEVEL_TOLERANCE_DB,
-            diagnostic: Some(
