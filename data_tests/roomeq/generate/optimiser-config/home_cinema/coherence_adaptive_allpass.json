{
  "system": {
    "model": "home_cinema",
    "speakers": { "L": "left", "R": "right", "C": "center", "SL": "surround_left", "SR": "surround_right", "TFL": "top_front_left", "TFR": "top_front_right", "TRL": "top_rear_left", "TRR": "top_rear_right", "LFE": "lfe" },
    "subwoofers": { "config": "mso", "crossover": "first", "lfe": "L" },
    "bass_management": {
      "enabled": true,
      "redirect_bass": true,
      "lfe_channel": "LFE",
      "lfe_playback_gain_db": 10.0,
      "apply_lfe_gain_to_chain": false,
      "sub_trim_db": -7.0,
      "max_sub_boost_db": 3.0,
      "headroom_margin_db": 24.0,
      "group_crossovers": { "lcr": "first", "surround": "first", "height": "first" },
      "optimize_groups": true
    }
  },
  "optimizer": {
    "processing_mode": "low_latency",
    "max_iter": 15000,
    "max_db": 6.25,
    "max_q": 5.0,
    "multi_measurement": { "strategy": "variance_penalized", "variance_lambda": 1.0 },
    "group_delay": {
      "enabled": true,
      "max_delay_ms": 20.0,
      "ap_per_channel": 2,
      "ap_min_q": 0.3,
      "ap_max_q": 10.0,
      "optimize_polarity": true,
      "coherence_threshold": 0.8,
      "min_improvement_db": 0.05,
      "max_iter": 500,
      "popsize": 20,
      "tol": 0.000001,
      "adaptive_allpass": true
    }
  }
}
