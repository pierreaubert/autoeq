-/// One re-parsed CamillaDSP filter stage.
-enum RealizedFilter {
-    Gain {
-        db: f64,
-        inverted: bool,
-    },
-    DelayMs(f64),
-    DelaySamples(f64),
-    InlineConv(Vec<f64>),
-    Biquad {
-        filter_type: BiquadFilterType,
-        freq: f64,
-        q: f64,
-        gain_db: f64,
-    },
-    Crossover {
-        lowpass: bool,
-        freq: f64,
-        q_values: Vec<f64>,
-    },
-    Conv {
-        file: String,
-    },
-}
-
-impl RealizedFilter {
-    fn response(
-        &self,
-        sample_rate: f64,
-        frequency: f64,
-        ir_registry: &HashMap<String, Vec<f64>>,
-    ) -> Complex64 {
-        match self {
-            Self::Gain { db, inverted } => {
-                let sign = if *inverted { -1.0 } else { 1.0 };
-                Complex64::new(sign * 10.0_f64.powf(db / 20.0), 0.0)
-            }
-            Self::DelayMs(delay_ms) => {
-                Complex64::from_polar(1.0, -TAU * frequency * delay_ms / 1000.0)
-            }
-            Self::DelaySamples(samples) => {
-                Complex64::from_polar(1.0, -TAU * frequency * samples / sample_rate)
-            }
-            Self::InlineConv(taps) => fir_response(taps, sample_rate, frequency),
-            Self::Biquad {
-                filter_type,
-                freq,
-                q,
-                gain_db,
-            } => Biquad::new(*filter_type, *freq, sample_rate, *q, *gain_db)
-                .complex_response(frequency),
-            Self::Crossover {
-                lowpass,
-                freq,
-                q_values,
-            } => q_values
-                .iter()
-                .map(|q| {
-                    Biquad::new(
-                        if *lowpass {
-                            BiquadFilterType::Lowpass
-                        } else {
-                            BiquadFilterType::Highpass
-                        },
-                        *freq,
-                        sample_rate,
-                        *q,
-                        0.0,
-                    )
-                    .complex_response(frequency)
-                })
-                .product(),
-            Self::Conv { file } => {
-                let taps = ir_registry
-                    .get(file)
-                    .unwrap_or_else(|| panic!("exported unknown convolution file '{file}'"));
-                fir_response(taps, sample_rate, frequency)
-            }
-        }
-    }
-}
