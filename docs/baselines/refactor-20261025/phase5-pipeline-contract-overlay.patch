+//! Shared application context and exact-recovery ports for RoomEQ coordination.
+
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+use std::io;
+use std::path::Path;
+
+use autoeq_artifacts::ArtifactStore;
+use autoeq_core::MeasurementSource;
+use roomeq_engine::eq::exact_recovery::ExactDERecoveryOptions;
+use roomeq_model::{Curve, RoomConfig};
+
+/// Receives immutable JSON events from an explicitly enabled finalization trace.
+pub trait FinalizationDiagnosticSink {
+    /// Persist one named event without changing optimization behavior.
+    ///
+    /// Implementations should reject duplicate event names and use atomic,
+    /// no-overwrite file publication when writing to disk.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when the event cannot be serialized or durably stored.
+    fn write_event(&self, name: &str, json: &[u8]) -> io::Result<()>;
+}
+
+/// Exact finalization trial selected for opt-in diagnostic capture.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FinalizationDiagnosticTrial {
+    /// Capture the unmodified-strength, output-safety candidate before fallback selection.
+    ZeroStrengthOutput,
+    /// Capture the full-strength output-safety candidate before fallback selection.
+    FullStrengthOutput,
+}
+
+/// Application-owned data accompanying an in-memory engine request.
+pub struct WorkflowContext<'a> {
+    /// Optional destination for generated artifacts.
+    pub output_dir: Option<&'a Path>,
+    /// Artifact persistence selected by the application.
+    pub artifact_store: &'a dyn ArtifactStore,
+    /// Measurements excluded from optimization and reserved for validation.
+    pub validation_measurements: &'a HashMap<String, Vec<Curve>>,
+}
+
+impl std::fmt::Debug for WorkflowContext<'_> {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.debug_struct("WorkflowContext").finish_non_exhaustive()
+    }
+}
+
+/// Supplies exact single-channel recovery without owning application persistence.
+///
+/// Implementations retain their existing configuration/input/build identity
+/// gates. Returned options must acknowledge checkpoint durability through the
+/// existing engine callback; no journal, lock, counter or publication state is
+/// transferred to the numerical coordinator.
+pub trait ExactRoomRecovery: Send + Sync {
+    /// Verify the configured run before preparing or scoring measurements.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error if configuration, input bytes, output identity, rate,
+    /// sample count, or supported recovery lane differs from the bound run.
+    fn verify_configuration(
+        &self,
+        room_config: &RoomConfig,
+        sample_rate_hz: f64,
+        frequency_samples: usize,
+    ) -> Result<(), String>;
+
+    /// Freeze the exact numerical measurement bound to this recovery session.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error if loading fails or the frozen curve identity differs
+    /// from the one bound at session creation.
+    fn freeze_and_verify_measurement_source(
+        &self,
+        source: &MeasurementSource,
+    ) -> Result<MeasurementSource, String>;
+
+    /// Obtain validated exact-DE state and its durable save callback.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error for a terminal session, invalid checkpoint identity,
+    /// terminal observer cancellation, or poisoned recovery state.
+    fn exact_de_options(&self) -> Result<ExactDERecoveryOptions, String>;
+}
