-        let underfill = evidence.final_db;
-        if !evidence.accepted {
-            return Err(format!(
-                "serialized_graph_acoustic_splice_underfill:{role}:{underfill:.3}db"
-            ));
-        }
-    }
-    Ok(())
-}
