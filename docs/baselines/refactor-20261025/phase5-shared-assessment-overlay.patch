-            failed_channels.push(name.clone());
-            continue;
-        };
-        let (error_frequency, realized_at_error, expected_at_error, channel_error) = realized
-            .spl
-            .iter()
-            .zip(&channel.final_curve.spl)
-            .zip(&realized.freq)
-            .filter(|(_, frequency)| **frequency >= low && **frequency <= high)
