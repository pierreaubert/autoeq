+    apply_result_delta_to_seat, band_metrics, curves_share_frequency_grid,
+    default_all_channel_spatial_robustness, measurement_source_count, predicted_seat_report,
+    resolve_all_channel_seat_weights, role_for_channel as engine_role_for_channel,
