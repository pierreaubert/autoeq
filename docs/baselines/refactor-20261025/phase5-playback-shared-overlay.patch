-                .collect::<Result<_, _>>()
-                .map_err(|error| format!("Failed to decode WAV '{}': {error}", path.display()))?
-        }
-    };
-    let samples = interleaved
-        .chunks_exact(channels)
-        .map(|frame| frame[0])
-        .collect::<Vec<_>>();
-    if samples.is_empty() {
-        return Err(format!("WAV '{}' contains no samples", path.display()));
-    }
-
-    Ok(DecodedMonoWav {
-        samples,
-        sample_rate: spec.sample_rate,
-    })
-}
