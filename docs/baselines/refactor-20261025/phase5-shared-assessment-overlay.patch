-    let front_reference = channels
-        .iter()
-        .filter(|channel| {
-            matches!(
-                channel.role,
-                roomeq_engine::home_cinema::HomeCinemaRole::FrontLeft
-                    | roomeq_engine::home_cinema::HomeCinemaRole::FrontRight
-                    | roomeq_engine::home_cinema::HomeCinemaRole::Center
-            )
-        })
-        .map(|channel| channel.final_arrival_ms)
-        .reduce(f64::min);
-    let Some(front_reference) = front_reference else {
-        return false;
