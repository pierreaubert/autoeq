-        .collect();
-    let mut baseline = result.clone();
-    seat_replay::restore_structural_baseline(&mut baseline);
-    if trials.iter().any(|trial| {
-        trial
-            .diagnostic
-            .as_deref()
-            .is_some_and(|reason| reason.contains("correlated-bass efficiency regressed"))
