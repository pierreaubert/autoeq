-pub(super) fn runtime_temporal_quality_evidence(
-    result: &RoomOptimizationResult,
-    names: &[String],
-    pre: &[roomeq_model::Curve],
-    post: &[roomeq_model::Curve],
-    sample_rate: f64,
-    _processing_mode: roomeq_model::ProcessingMode,
