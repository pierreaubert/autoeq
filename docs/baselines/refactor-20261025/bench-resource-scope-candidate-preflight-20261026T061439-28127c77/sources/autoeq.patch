-    /// Evaluate with sign-dependent, precomputed per-sample multipliers.
-    pub fn evaluate_asymmetric(
-        &self,
-        error: &Array1<f64>,
-        peak_weights: &[f64],
-        dip_weights: &[f64],
-        erb_mix: f64,
-        band_mix: f64,
