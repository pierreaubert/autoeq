-fn serial_delay(plugins: &[PluginConfigWrapper], fs: f64) -> Option<f64> {
-    let mut delay = 0.0;
-    for plugin in plugins {
-        if matches!(plugin.plugin_type.as_str(), "band_split" | "band_merge") {
