+                    let initial: Curve = chain
+                        .initial_curve
+                        .clone()
+                        .ok_or_else(|| AutoeqError::InvalidMeasurement {
+                            message: format!(
+                                "channel '{}' has no initial curve for Post-EQ rollback",
+                                name
+                            ),
+                        })?
+                        .into();
