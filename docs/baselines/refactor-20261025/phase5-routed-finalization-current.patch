-    let points: Vec<(f64, f64)> = freq
-        .iter()
-        .zip(spl.iter())
-        .filter(|(frequency, level)| {
-            **frequency >= endpoint / std::f64::consts::SQRT_2
-                && frequency.is_finite()
-                && level.is_finite()
