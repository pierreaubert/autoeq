+pub fn is_splice_breaking_correction_eq(plugin: &PluginConfigWrapper) -> bool {
+    if plugin.plugin_type != "eq" {
+        return false;
+    }
+    let stage = plugin
+        .parameters
+        .get("room_eq_stage")
+        .and_then(serde_json::Value::as_str);
+    if stage != Some("post_route") {
+        return false;
+    }
+    matches!(
+        plugin
+            .parameters
+            .get("label")
+            .and_then(serde_json::Value::as_str),
+        Some("room_eq_correction") | Some("post_eq")
+    )
+}
