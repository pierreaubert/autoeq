-            [1000.0, f64::NAN],
-        ] {
-            assert!(reference_band_energy_db(&grid, &levels, &[1.0]).is_none());
-        }
-        let grid = [1000.0, 2000.0];
-        for weights in [
-            vec![],
-            vec![0.0],
-            vec![-1.0],
