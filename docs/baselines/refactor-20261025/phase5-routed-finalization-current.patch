-                    .ok_or_else(|| failed("missing selected FIR path"))?;
-                let mut data = crate::ctc::read_wav_channels_f64(
-                    &dir.join(path),
-                    crate::ctc::checked_sample_rate(fs)?,
-                    "selected correction FIR",
-                )?;
