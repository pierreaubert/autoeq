        "\t-E 'test(/equalizer_apo|easyeffects|wavelet|roon/)'"
      ],
      "source_evidence": "Justfile AST; dependency edges plus manually reviewed executed body calls"
    },
    "qa-export-camilladsp": {
      "dependencies": [],
      "body_calls": [],
      "parameters": [],
      "body": [
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        "validator=\"${ROOMEQ_CAMILLADSP_BIN:-camilladsp}\"",
        "if ! command -v \"$validator\" >/dev/null 2>&1; then",
        "\techo \"CamillaDSP validator not found: $validator\" >&2",
        "\techo \"Run 'just install-export-test-systems' or set ROOMEQ_CAMILLADSP_BIN.\" >&2",
        "\texit 1",
        "fi",
        "ROOMEQ_CAMILLADSP_VALIDATE_CMD=\"$validator --check {config}\" \\",
        "\t{{cargo}} nextest run --release -p roomeq-export --lib --no-tests fail -E 'test(/camilladsp/)'"
      ],
      "source_evidence": "Justfile AST; dependency edges plus manually reviewed executed body calls"
    },
    "qa-export-pipewire": {
      "dependencies": [],
      "body_calls": [],
      "parameters": [],
      "body": [
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        "if ! command -v docker >/dev/null 2>&1; then",
        "\techo \"Docker is required for Linux PipeWire export validation.\" >&2",
        "\texit 1",
        "fi",
        "if ! docker info >/dev/null 2>&1; then",
        "\techo \"Docker is installed but its daemon is not available.\" >&2",
        "\texit 1",
        "fi",
        "requested_base_image=\"${AUTOEQ_PIPEWIRE_BASE_IMAGE:-math-audio-base-linux-arm64:latest}\"",
        "if ! docker image inspect \"$requested_base_image\" >/dev/null 2>&1; then",
        "\techo \"AutoEQ Linux test base image not found: $requested_base_image\" >&2",
        "\techo \"Set AUTOEQ_PIPEWIRE_BASE_IMAGE to an existing Linux test image.\" >&2",
        "\texit 1",
        "fi",
        "base_image=\"$requested_base_image\"",
        "# Cargo path dependencies resolve against the pinned sibling checkouts.",
        "checkout_root=\"$(cd .. && pwd)\"",
        "if [[ \"$(pwd)\" != \"$checkout_root/autoeq\" || ! -f \"$checkout_root/scripts/release/sources.json\" ]]; then",
        "\techo \"PipeWire export QA requires the pinned all_of_sotf sibling checkout.\" >&2",
        "\texit 1",
        "fi",
        "toolchain=\"$(docker run --rm --entrypoint bash \"$base_image\" -c 'rustup toolchain list | sed -n \"s/ (active.*//p\" | head -n 1')\"",
        "if [[ -z \"$toolchain\" ]]; then",
        "\techo \"Could not determine the active Rust toolchain in $base_image.\" >&2",
        "\texit 1",
        "fi",
        "if [[ \"${AUTOEQ_PIPEWIRE_BASE_READY:-0}\" == 1 ]]; then",
        "\t# The dedicated release image already has PipeWire; use its immutable ID.",
        "\tqa_image=\"$base_image\"",
        "else",
        "\timage_id_file=\"$(mktemp)\"",
        "\ttrap 'rm -f \"$image_id_file\"' EXIT",
        "\tdocker build --build-arg BASE_IMAGE=\"$base_image\" --iidfile \"$image_id_file\" -f builds/qa/Dockerfile.pipewire .",
        "\tqa_image=\"$(cat \"$image_id_file\")\"",
        "fi",
        "docker run --rm \\",
        "\t-v \"$checkout_root\":/all_of_sotf \\",
        "\t-v autoeq-pipewire-cargo-registry:/root/.cargo/registry \\",
        "\t-v autoeq-pipewire-cargo-git:/root/.cargo/git \\",
        "\t-v autoeq-pipewire-target:/target \\",
        "\t-w /all_of_sotf/autoeq \\",
        "\t-e CARGO_TARGET_DIR=/target \\",
        "\t-e RUSTUP_TOOLCHAIN=\"$toolchain\" \\",
        "\t-e CARGO_HTTP_MULTIPLEXING=false \\",
        "\t-e CARGO_NET_RETRY=10 \\",
        "\t\"$qa_image\" \\",
        "\tbash -c 'ROOMEQ_PIPEWIRE_VALIDATE_CMD=\"bash scripts/validate-pipewire-config.sh {config}\" bash scripts/run-pipewire-export-tests.sh'"
      ],
      "source_evidence": "Justfile AST; dependency edges plus manually reviewed executed body calls"
    },
