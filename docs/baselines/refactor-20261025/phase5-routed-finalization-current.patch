+            [40.0, 119.0],
+            &grid(),
+            1e-6,
+            &mut state,
+            &mut ledger,
+        )
+        .expect("apply succeeds");
+        assert!(applied.applied_replays.iter().all(|row| row.replayed_ok));
+        let inputs: Vec<SeatCombinedInput<'_>> = seats
+            .iter()
+            .map(|seat| SeatCombinedInput {
+                seat_id: seat.seat_id.as_str(),
+                freqs: &seat.freqs,
