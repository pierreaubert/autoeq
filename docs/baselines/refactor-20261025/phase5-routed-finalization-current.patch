-            }
-            Self::Delay {
-                channel,
-                driver_index,
-                target_ms,
-                ..
-            } => format!("joint_drive_delay_{channel}_{driver_index}_to_{target_ms:.9}"),
-            Self::GainDelay { gain, delay } => format!(
