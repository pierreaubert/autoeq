{
  "version": "3.0.0",
  "system": {
    "model": "stereo",
    "speakers": {
      "R": "right",
      "L": "left"
    },
    "subwoofers": {
      "strategy": "mso",
      "routing": "optimize",
      "outputs": [
        {
          "id": "Sub1",
          "speaker": "lfe_1"
        },
        {
          "id": "Sub2",
          "speaker": "lfe_2"
        }
      ],
      "crossover": [
        "first",
        "first"
      ]
    }
  },
  "speakers": {
    "left": {
      "measurements": [
        {
          "path": "left_lp0.csv",
          "name": "lp0"
        },
        {
          "path": "left_lp1.csv",
          "name": "lp1"
        }
      ],
      "provenance": {
        "capture_kind": "stationary_ir",
        "timing_reference_id": "fem-simulation-medium_multi_sub_multi_seat"
      }
    },
    "right": {
      "measurements": [
        {
          "path": "right_lp0.csv",
          "name": "lp0"
        },
        {
          "path": "right_lp1.csv",
          "name": "lp1"
        }
      ],
      "provenance": {
        "capture_kind": "stationary_ir",
        "timing_reference_id": "fem-simulation-medium_multi_sub_multi_seat"
      }
    },
    "lfe_1": {
      "measurements": [
        {
          "path": "sub1_lp0.csv",
          "name": "lp0"
        },
        {
          "path": "sub1_lp1.csv",
          "name": "lp1"
        }
      ],
      "provenance": {
        "capture_kind": "stationary_ir",
        "timing_reference_id": "fem-simulation-medium_multi_sub_multi_seat"
      }
    },
    "lfe_2": {
      "measurements": [
        {
          "path": "sub2_lp0.csv",
          "name": "lp0"
        },
        {
          "path": "sub2_lp1.csv",
          "name": "lp1"
        }
      ],
      "provenance": {
        "capture_kind": "stationary_ir",
        "timing_reference_id": "fem-simulation-medium_multi_sub_multi_seat"
      }
    }
  },
  "crossovers": {
    "first": {
      "type": "LR24",
      "frequency": 80.0
    }
  },
  "optimizer": {
    "processing_mode": "low_latency",
    "loss_type": "flat",
    "algorithm": "autoeq:de",
    "strategy": "currenttobest1bin",
    "num_filters": 7,
    "min_filter_improvement": 0.01,
    "elimination_threshold": 0.01,
    "min_q": 0.5,
    "max_q": 10.0,
    "min_db": -12.0,
    "max_db": 12.0,
    "min_freq": 20.0,
    "max_freq": 999.9999999999998,
    "max_iter": 15000,
    "population": 30,
    "peq_model": "pk",
    "seed": 42,
    "refine": true,
    "asymmetric_loss": true,
    "smooth_n": 3,
    "multi_measurement": {
      "strategy": "minimax",
      "variance_lambda": 1.0
    }
  }
}
