+    final_curves: &HashMap<String, roomeq_model::Curve>,
+) -> Vec<HashMap<String, roomeq_model::Curve>> {
+    role_aware_channel_matching_groups_with_keys(final_curves)
+        .into_iter()
+        .map(|group| group.curves)
+        .collect()
+}
