-                _ => {
-                    return Err(format!(
-                        "final record '{}' is not bound to the delivered graph '{}'; \
-                         repeat reconciliation and verification",
-                        record.decision_id, delivered_identity.fingerprint
-                    ));
-                }
-            }
-        }
