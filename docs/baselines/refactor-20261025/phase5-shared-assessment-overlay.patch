+            report.metrics.pre_target_weighted_rms_db,
+            training.pre_weighted_rms_median_db
+        );
+        assert_eq!(
+            report.metrics.post_target_weighted_rms_db,
+            training.post_weighted_rms_median_db
+        );
+    }
+}
