{
  "system": {
    "model": "home_cinema",
    "speakers": { "L": "left", "R": "right", "C": "center", "SL": "surround_left", "SR": "surround_right", "TFL": "top_front_left", "TFR": "top_front_right", "TRL": "top_rear_left", "TRR": "top_rear_right", "LFE": "lfe" },
    "subwoofers": { "config": "single", "crossover": "first", "lfe": "L" },
    "bass_management": {
      "enabled": true,
      "redirect_bass": true,
      "lfe_channel": "LFE",
      "lfe_playback_gain_db": 10.0,
      "apply_lfe_gain_to_chain": false,
      "sub_trim_db": -7.0,
      "max_sub_boost_db": 2.0,
      "headroom_margin_db": 18.0,
      "group_crossovers": { "lcr": "first", "surround": "first", "height": "first" },
      "optimize_groups": true
    }
  },
  "optimizer": {
    "processing_mode": "mixed_phase",
    "max_db": 6.5,
    "max_q": 5.0,
    "fir": {
      "taps": 1024,
      "phase": "kirkeby",
      "correct_excess_phase": true,
      "phase_smoothing": 0.167
    },
    "mixed_phase": {
      "max_fir_length_ms": 2.0,
      "pre_ringing_threshold_db": -30.0,
      "min_spatial_depth": 0.5,
      "phase_smoothing_octaves": 0.75
    },
    "multi_measurement": { "strategy": "variance_penalized", "variance_lambda": 1.0 },
    "phase_alignment": {
      "enabled": true,
      "min_freq": 50.0,
      "max_freq": 120.0,
      "optimize_polarity": true,
      "max_delay_ms": 20.0
    }
  }
}
