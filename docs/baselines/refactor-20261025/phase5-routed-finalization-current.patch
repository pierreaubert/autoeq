-            return Err(format!("mono-bass input {index} is nonfinite"));
-        }
-    }
-    let bins: Vec<usize> = grid
-        .iter()
-        .enumerate()
-        .filter(|(_, frequency)| **frequency <= max_mono_hz)
-        .map(|(index, _)| index)
