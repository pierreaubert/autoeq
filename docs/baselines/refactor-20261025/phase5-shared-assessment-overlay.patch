-                let context = ReplayContext {
-                    config: &baseline.observation,
-                    partition: &seat.partition,
-                    fs: self.fs,
-                    dir: self.dir,
-                };
-                let (mut post, delivered_outputs) = replay(
-                    &replay_result,
-                    physical,
-                    &seat.logical_input,
-                    seat.seat_index,
-                    false,
