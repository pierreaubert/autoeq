+use super::types::WorkflowProgressCallback;
+use super::types::WorkflowProgressCallbackFactory;
+use super::types::WorkflowStageCallback;
+use roomeq_engine::error::{AutoeqError, Result};
+use roomeq_engine::{PipelineStepId, PipelineStepStatus};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+
+pub fn workflow_stage_event(
+    stage_callback: &mut Option<&mut WorkflowStageCallback<'_>>,
+    step_id: PipelineStepId,
+    status: PipelineStepStatus,
+    message: &str,
+    overall_progress: f64,
+) -> Result<()> {
+    if let Some(callback) = stage_callback.as_deref_mut() {
+        callback(step_id, status, message, overall_progress)?;
+    }
+    Ok(())
+}
+
+pub fn workflow_progress_callback(
+    progress_factory: &Option<&WorkflowProgressCallbackFactory<'_>>,
+    role: &str,
+    channel_index: usize,
+    total_channels: usize,
+    max_iterations: usize,
+) -> Option<WorkflowProgressCallback> {
+    progress_factory
+        .as_deref()
+        .and_then(|factory| factory(role, channel_index, total_channels, max_iterations))
+}
+
+pub fn workflow_progress_stopped(
+    stopped: &Option<Arc<AtomicBool>>,
+    step: &'static str,
+) -> Result<()> {
+    if stopped
+        .as_ref()
+        .is_some_and(|flag| flag.load(Ordering::Relaxed))
+    {
+        return Err(AutoeqError::OptimizationFailed {
+            message: format!("Room optimization stopped by observer during {step}"),
+        });
+    }
+    Ok(())
+}
+
+/// Preserve both observer stop returns and its shared cancellation flag.
+pub fn workflow_search_callback(
+    mut progress: WorkflowProgressCallback,
+) -> roomeq_engine::OptimProgressCallback {
+    Box::new(move |iteration, loss, preference| {
+        if progress.stopped.load(Ordering::Relaxed) {
+            return roomeq_engine::CallbackAction::Stop;
+        }
+        let action = (progress.callback)(iteration, loss, preference);
+        if matches!(action, roomeq_engine::CallbackAction::Stop) {
+            progress.stopped.store(true, Ordering::Relaxed);
+        }
+        if progress.stopped.load(Ordering::Relaxed) {
+            roomeq_engine::CallbackAction::Stop
+        } else {
+            action
+        }
+    })
+}
