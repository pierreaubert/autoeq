+//! Application operations used by routed orchestration.
+
+use std::path::Path;
+use roomeq_engine::error::Result;
+use roomeq_engine::{Curve, OptimProgressCallback, OptimizerRunEvidence};
+use roomeq_engine::room_result::ChannelOptimizationResult;
+use roomeq_engine::group_processing::{PreparedMultiSubGroup, GroupProcessingResult};
+use roomeq_engine::eq::EqResources;
+use roomeq_engine::dba::DbaPreparedInput;
+use roomeq_engine::multisub::MultiSubOptimizationResult;
+use math_audio_iir_fir::Biquad;
+use roomeq_model::{ChannelDspChain, MeasurementSource, MultiSubGroup, OptimizerConfig, DBAConfig,
+    RoomConfig, SupportingSourceGroup, SupportingSourceOutputNaming, SupportingSourceReport};
+
+pub type ChannelWorkflowResult = (
+    ChannelDspChain,
+    f64,
+    f64,
+    Curve,
+    Curve,
+    Vec<Biquad>,
+    f64,
+    Option<f64>,
+    Option<Vec<f64>>,
+    Vec<OptimizerRunEvidence>,
+    Vec<roomeq_model::FilterVetoVerdict>,
+    Option<roomeq_model::VetoAdjudicationReport>,
+    Option<roomeq_engine::channel_measurements::MeasurementConditioningReceipt>,
+    Option<roomeq_engine::segment_support::SegmentSupportReport>,
+);
+
+/// Supporting-source chains, results, and evidence from the owning application.
+pub type SupportingWorkflowResult = ((ChannelDspChain, ChannelDspChain), (ChannelOptimizationResult, ChannelOptimizationResult), SupportingSourceReport);
+
+/// Resource and execution operations retained by the application.
+///
+/// Implementations preserve their measurement identity, recovery, and sidecar ownership.
+pub trait RoutingApplication: Send + Sync {
+    #[expect(clippy::too_many_arguments, reason = "preserve existing application operation inputs")]
+    fn process_single_channel_with_frequency_samples(
+        &self,
+        channel_name: &str,
+        source: &MeasurementSource,
+        room_config: &RoomConfig,
+        sample_rate: f64,
+        output_dir: &Path,
+        callback: Option<OptimProgressCallback>,
+        probe_arrival_ms: Option<f64>,
+        shared_mean_spl: Option<f64>,
+        frequency_samples: usize,
+    ) -> Result<ChannelWorkflowResult>;
+    fn process_supporting_source_channel_with_frequency_samples(
+        &self,
+        logical_role: &str,
+        group: &SupportingSourceGroup,
+        room_config: &RoomConfig,
+        sample_rate: f64,
+        output_dir: &Path,
+        naming: Option<&SupportingSourceOutputNaming>,
+        frequency_samples: usize,
+    ) -> Result<SupportingWorkflowResult>;
+    fn optimize_multisub_with_frequency_samples(
+        &self,
+        measurements: &[MeasurementSource],
+        config: &OptimizerConfig,
+        sample_rate: f64,
+        frequency_samples: usize,
+    ) -> std::result::Result<MultiSubOptimizationResult, Box<dyn std::error::Error>>;
+    fn prepare_dba_with_frequency_samples(
+        &self,
+        config: &DBAConfig,
+        frequency_samples: usize,
+    ) -> std::result::Result<DbaPreparedInput, Box<dyn std::error::Error>>;
+    #[expect(clippy::too_many_arguments, reason = "preserve existing application operation inputs")]
+    fn process_multisub_group_with_callback(
+        &self,
+        channel_name: &str,
+        group: &MultiSubGroup,
+        room_config: &RoomConfig,
+        sample_rate: f64,
+        prepared: &PreparedMultiSubGroup,
+        eq_resources: &EqResources,
+        flat_eq_resources: &EqResources,
+        callback: Option<OptimProgressCallback>,
+    ) -> Result<GroupProcessingResult>;
+}
