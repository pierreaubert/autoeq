-        .channels
-        .iter()
-        .map(|(name, chain)| {
-            let drivers = chain.drivers.as_ref().map(|drivers| {
-                drivers.iter().map(|driver| {
-            serde_json::json!({"name": driver.name, "plugins": driver.plugins})
-        }).collect::<Vec<_>>()
-            });
