-        expand_independent_electrical_paths(
-            &graph.channels,
-            &independent_graph_output_ports(&graph.channels),
-        )?
-    };
-    let mut attenuation_by_output = BTreeMap::new();
-    for path in paths {
-        let mut attenuation_db = 0.0_f64;
