+pub(in super::super) fn lcr_timing_advisory(
+    channels: &[roomeq_engine::home_cinema::ChannelTimingReport],
+) -> Option<String> {
+    let front_or_center: Vec<_> = channels
+        .iter()
+        .filter(|channel| {
+            matches!(
+                channel.role,
+                roomeq_engine::home_cinema::HomeCinemaRole::FrontLeft
+                    | roomeq_engine::home_cinema::HomeCinemaRole::FrontRight
+                    | roomeq_engine::home_cinema::HomeCinemaRole::Center
+            )
+        })
+        .collect();
+    if front_or_center.len() < 2 {
+        return None;
+    }
+    let values: Vec<f64> = front_or_center
+        .iter()
+        .map(|channel| channel.final_arrival_ms)
+        .collect();
+    if spread(&values).unwrap_or(0.0) > 0.5 {
+        Some("lcr_imaging_timing_spread".to_string())
+    } else {
+        None
+    }
+}
+
+pub(in super::super) fn surround_or_height_precedence_risk(
+    channels: &[roomeq_engine::home_cinema::ChannelTimingReport],
+) -> bool {
+    let front_reference = channels
+        .iter()
+        .filter(|channel| {
+            matches!(
+                channel.role,
+                roomeq_engine::home_cinema::HomeCinemaRole::FrontLeft
+                    | roomeq_engine::home_cinema::HomeCinemaRole::FrontRight
+                    | roomeq_engine::home_cinema::HomeCinemaRole::Center
+            )
+        })
+        .map(|channel| channel.final_arrival_ms)
+        .reduce(f64::min);
+    let Some(front_reference) = front_reference else {
+        return false;
+    };
+    channels.iter().any(|channel| {
+        let surround_or_height = matches!(
+            channel.role,
+            roomeq_engine::home_cinema::HomeCinemaRole::SideSurroundLeft
+                | roomeq_engine::home_cinema::HomeCinemaRole::SideSurroundRight
+                | roomeq_engine::home_cinema::HomeCinemaRole::RearSurroundLeft
+                | roomeq_engine::home_cinema::HomeCinemaRole::RearSurroundRight
+                | roomeq_engine::home_cinema::HomeCinemaRole::WideLeft
+                | roomeq_engine::home_cinema::HomeCinemaRole::WideRight
+        ) || channel.role.is_height();
+        surround_or_height && channel.final_arrival_ms + 0.5 < front_reference
+    })
+}
