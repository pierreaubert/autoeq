-    // serial sections still contribute, including a previous output match.
-    let total = serial_delay(&plugins[..start], fs)?
-        + declared_delay(fir, fs)?.max(opposite)
-        + serial_delay(&plugins[end + 1..], fs)?;
-    total.is_finite().then_some(total)
-}
