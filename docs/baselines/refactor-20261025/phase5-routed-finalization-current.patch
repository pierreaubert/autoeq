+/// Select against the final graph, after all late processing and artifact binding.
+#[allow(clippy::too_many_arguments)]
+pub fn select(
+    result: &mut RoomOptimizationResult,
+    captures: &[seat_replay::Capture],
+    held_out: &HashMap<String, Vec<Curve>>,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+    store: &dyn autoeq_artifacts::ArtifactStore,
+) -> Result<()> {
+    select_with_diagnostic_sink(result, captures, held_out, config, fs, dir, store, None)
+}
+
+#[expect(
+    clippy::too_many_arguments,
+    reason = "The diagnostic sink is an opt-in extension of the established selection inputs"
+)]
+pub fn select_with_diagnostic_sink(
+    result: &mut RoomOptimizationResult,
+    captures: &[seat_replay::Capture],
+    held_out: &HashMap<String, Vec<Curve>>,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+    store: &dyn autoeq_artifacts::ArtifactStore,
+    diagnostic: Option<(
+        roomeq_workflow_contracts::FinalizationDiagnosticTrial,
+        &dyn roomeq_workflow_contracts::FinalizationDiagnosticSink,
+    )>,
+) -> Result<()> {
+    let snapshot = result.clone();
+    let mut diagnostics = diagnostic.map(|(_, sink)| FinalizationDiagnosticCapture::new(sink));
+    let selection = select_inner(
+        result,
+        captures,
+        held_out,
+        config,
+        fs,
+        dir,
+        store,
+        diagnostic.map(|(trial, _)| trial),
+        diagnostics.as_mut().map(|capture| &mut *capture),
+    )
+    .and_then(|()| {
+        if let Err(error) =
+            seat_replay::validate_final_correlated_bass(result, captures, held_out, config, fs, dir)
+        {
+            publish_baseline(
+                result,
+                captures,
+                held_out,
+                config,
+                fs,
+                dir,
+                store,
+                "final_correlated_bass_refused",
+                vec![StageCheck::fail(
+                    "final_correlated_bass",
+                    StageCheckKind::Quality,
+                    error.to_string(),
+                )],
+            )?;
+            seat_replay::validate_final_correlated_bass(
+                result, captures, held_out, config, fs, dir,
+            )?;
+        }
+        verify_delivered_channel_alignment(result, config, fs, dir)
+    });
+    match selection {
+        Ok(()) => {
+            // WP4a advisory: correlated (identical-drive) bass through the
+            // final serialized matrix. Pruning may still trim inaudible EQ
+            // afterwards; the advisory transfers within its JND bound.
+            let mono_bass = seat_replay::correlated_bass_stage(result, captures, config, fs, dir);
+            result.metadata.stage_outcomes.push(mono_bass);
+            if let Some(report) = result.metadata.correction_acceptance.as_mut() {
+                super::validation_scorecard::align_report_metrics_to_scorecard(report);
+                report.refresh_outcome();
+            }
+            if let Some(capture) = diagnostics.as_mut()
+                && let Err(error) = capture.complete(result)
+            {
+                *result = snapshot;
+                Err(error)
+            } else {
+                Ok(())
+            }
+        }
+        Err(error) => {
+            *result = snapshot;
+            Err(error)
+        }
+    }
+}
+
+pub fn verify_declared_physical_drive(
+    result: &mut RoomOptimizationResult,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+) -> Result<Option<f64>> {
+    result
+        .metadata
+        .stage_outcomes
+        .retain(|stage| stage.stage != "final_graph_declared_physical_drive");
+    let assessments = roomeq_playback::electrical_headroom::assess_final_graph_physical_drive(
+        &result.to_dsp_chain_output(),
+        fs,
+        dir,
+        &config.optimizer.finalization,
+    )?;
+    if assessments.is_empty() {
+        return Ok(None);
+    }
+    if assessments
+        .iter()
+        .any(|assessment| !assessment.passes_declared_samples)
+    {
+        return Err(failed(format!(
+            "declared physical-drive check failed: {}",
+            serde_json::to_string(&assessments).map_err(|e| failed(e.to_string()))?
+        )));
+    }
+    result.metadata.stage_outcomes.push(StageOutcome {
+        stage: "final_graph_declared_physical_drive".into(),
+        status: StageStatus::Applied,
+        advisories: vec![
+            "operator_declared_calibration_and_limits_not_authenticated_hardware_evidence".into(),
+            "sampled_steady_sine_only_not_continuous_band_transient_thermal_or_program_capacity"
+                .into(),
+            "all_declared_quantities_checked; undeclared_physical_constraints_remain_unknown"
+                .into(),
+            "independently_phased_input_peak_bounds; nonlinear_protection_not_credited".into(),
+        ],
+        checks: assessments
+            .iter()
+            .map(|assessment| {
+                Ok(StageCheck {
+                    id: format!(
+                        "declared_physical_drive:{}:{:?}",
+                        assessment.output, assessment.declaration.quantity
+                    ),
+                    kind: StageCheckKind::Safety,
+                    passed: assessment.passes_declared_samples,
+                    observed: Some(assessment.max_utilization),
+                    limit: Some(1.0),
+                    diagnostic: Some(
+                        serde_json::to_string(assessment).map_err(|e| failed(e.to_string()))?,
+                    ),
+                })
+            })
+            .collect::<Result<Vec<_>>>()?,
+    });
+    Ok(Some(
+        assessments
+            .iter()
+            .map(|assessment| assessment.max_utilization)
+            .fold(0.0_f64, f64::max),
+    ))
+}
+
+/// Verify realized playback, not the last successful alignment stage's cache.
+///
+/// Runs for routed and plain channel results alike: per-output headroom
+/// gains can rebalance plain channels after the last alignment replay, so
+/// non-routed graphs need the same delivered-spread gate.
+fn verify_delivered_channel_alignment(
+    result: &mut RoomOptimizationResult,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+) -> Result<()> {
+    refresh_responses(result, fs, dir)?;
+    let reference_curves = result
+        .channel_results
+        .iter()
+        .map(|(name, channel)| (name.clone(), channel.initial_curve.clone()))
+        .collect();
+    let (_, spread, band) =
+        final_role_level_alignment_gains(config, &result.deployed_source_curves, &reference_curves);
+    if !spread.is_finite() {
+        return Err(failed(format!(
+            "delivered channel-level spread {spread:.3} dB exceeds {:.3} dB over {:.1}-{:.1} Hz",
+            FINAL_CHANNEL_LEVEL_TOLERANCE_DB, band.0, band.1,
+        )));
+    }
+    let structural_fallback = result.metadata.stage_outcomes.iter().any(|stage| {
+        stage.stage == "final_correction_selection"
+            && stage
+                .advisories
+                .iter()
+                .any(|advisory| advisory == "structural_baseline_published")
+    }) && result
+        .metadata
+        .correction_acceptance
+        .as_ref()
+        .is_some_and(|report| !report.accepted);
+    // A correction-free fallback may retain the room's original imbalance.
+    // Require its frozen reference, the same evaluation band, and independently
+    // replayed safety/seat evidence; never give a corrected graph this allowance.
+    let baseline_reference = result
+        .metadata
+        .stage_outcomes
+        .iter()
+        .find(|stage| stage.stage == "structural_baseline_channel_alignment_reference")
+        .and_then(|stage| {
+            stage
+                .checks
+                .iter()
+                .find(|check| check.id == "structural_baseline_channel_level_spread_db")
+        })
+        .and_then(|check| {
+            let reference = check.observed.filter(|value| value.is_finite())?;
+            let reference_band: [f64; 2] =
+                serde_json::from_str(check.diagnostic.as_deref()?).ok()?;
+            (reference_band == [band.0, band.1]).then_some(reference)
+        });
+    let preserves_baseline = structural_fallback
+        && baseline_reference.is_some_and(|reference| spread <= reference + 1e-6)
+        && result
+            .metadata
+            .correction_acceptance
+            .as_ref()
+            .is_some_and(|report| {
+                baseline_has_safety_evidence(report)
+                    && report.runtime_policy.as_ref().is_some_and(|policy| {
+                        report.acoustic_quality.as_ref().is_some_and(|score| {
+                            !score.final_seats.is_empty()
+                                && score.final_seats.iter().all(|seat| {
+                                    seat.improvement_lower_bound_db.is_finite()
+                                        && seat.improvement_lower_bound_db
+                                            >= -policy.max_worst_position_regression_db
+                                })
+                        })
+                    })
+                    && !report.violations.iter().any(|violation| {
+                        violation == "worst_position_regressed"
+                            || violation.contains("output_loss")
+                            || violation.contains("safety_attenuation_budget")
+                    })
+            });
+    if spread > FINAL_CHANNEL_LEVEL_TOLERANCE_DB && !structural_fallback {
+        return Err(failed(format!(
+            "delivered channel-level spread {spread:.3} dB exceeds {:.3} dB over {:.1}-{:.1} Hz",
+            FINAL_CHANNEL_LEVEL_TOLERANCE_DB, band.0, band.1,
+        )));
+    }
+    let mut check = StageCheck::pass("delivered_channel_level_spread_db", StageCheckKind::Safety);
+    check.observed = Some(spread);
+    check.limit = Some(FINAL_CHANNEL_LEVEL_TOLERANCE_DB);
+    check.passed = spread <= FINAL_CHANNEL_LEVEL_TOLERANCE_DB;
+    result
+        .metadata
+        .stage_outcomes
+        .retain(|stage| stage.stage != "final_delivered_channel_alignment");
+    let mut checks = vec![check];
+    if structural_fallback
+        && spread > FINAL_CHANNEL_LEVEL_TOLERANCE_DB
+        && let Some(reference) = baseline_reference
+    {
+        checks.push(StageCheck {
+            id: "delivered_channel_imbalance_does_not_exceed_baseline".into(),
+            kind: StageCheckKind::Safety,
+            passed: preserves_baseline,
+            observed: Some(spread),
+            limit: Some(reference + 1e-6),
+            diagnostic: Some("Same-band correction-free reference; safety and all-seat non-regression evidence required".into()),
+        });
+    }
+    let alignment_passed = checks[0].passed;
+    result.metadata.stage_outcomes.push(StageOutcome {
+        stage: "final_delivered_channel_alignment".into(),
+        status: if alignment_passed {
+            StageStatus::Applied
+        } else {
+            StageStatus::Degraded
+        },
+        checks,
+        advisories: vec![format!(
+            "replayed_band_hz={:.1}-{:.1}; spread_db={spread:.6}; limit_db={FINAL_CHANNEL_LEVEL_TOLERANCE_DB:.6}",
+            band.0, band.1
+        )],
+    });
+    if spread > FINAL_CHANNEL_LEVEL_TOLERANCE_DB
+        && !preserves_baseline
+        && let Some(report) = result.metadata.correction_acceptance.as_mut()
+    {
+        report.accepted = false;
+        report.decision = roomeq_model::CorrectionDecision::Rejected;
+        report
+            .violations
+            .push("baseline_delivered_channel_level_spread".into());
+        report.violations.sort();
+        report.violations.dedup();
+        report.refresh_outcome();
+    }
+    Ok(())
+}
+
+/// True when the candidate applies no meaningful correction.
+///
+/// Single definition of realized identity shared by the primary-metric
+/// check and the benefit floor: a candidate below both thresholds has
+/// nothing worth rejecting, so the floor skips it and selection treats
+/// it as the protected baseline.
+fn is_identity_correction(metrics: &roomeq_model::CorrectionMetricSummary) -> bool {
+    metrics.correction_rms_db.abs() <= 1e-6 && metrics.max_abs_correction_db.abs() <= 1e-6
+}
+
+/// Require demonstrated benefit on every training seat.
+///
+/// Held-out seats validate non-regression elsewhere; the seats the optimizer
+/// trained on must improve beyond the uncertainty-adjusted floor. A nonfinite
+/// bound fails closed: it cannot demonstrate benefit. Callers skip
+/// identity candidates: the floor rejects useless corrections, not the
+/// absence of correction.
+fn training_seats_show_benefit(
+    final_seats: &[roomeq_model::FinalSeatEvaluation],
+    floor_db: f64,
+) -> std::result::Result<(), String> {
+    for seat in final_seats
+        .iter()
+        .filter(|seat| seat.partition == "training")
+    {
+        // NaN lower bounds fail closed: only a strict improvement counts.
+        if seat.improvement_lower_bound_db.partial_cmp(&floor_db)
+            != Some(std::cmp::Ordering::Greater)
+        {
+            return Err(format!(
+                "training '{}' seat {} shows no benefit beyond uncertainty (lower bound {:.3} dB <= floor {:.3} dB)",
+                seat.logical_input, seat.seat_index, seat.improvement_lower_bound_db, floor_db
+            ));
+        }
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn select_inner(
+    result: &mut RoomOptimizationResult,
+    captures: &[seat_replay::Capture],
+    held_out: &HashMap<String, Vec<Curve>>,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+    store: &dyn autoeq_artifacts::ArtifactStore,
+    diagnostic_trial: Option<roomeq_workflow_contracts::FinalizationDiagnosticTrial>,
+    mut diagnostics: Option<&mut FinalizationDiagnosticCapture<'_>>,
+) -> Result<()> {
+    config.optimizer.finalization.validate().map_err(failed)?;
+    // Resolve configured output IDs against the actual routed graph before
+    // candidate search. A stale or misspelled key must never be ignored.
+    let initial_safety_budget_checks = output_safety_attenuation_budget_checks(result, config)?;
+    let initial_safety_budget_failure =
+        output_safety_attenuation_failure(&initial_safety_budget_checks);
+
+    // CTC measurements describe ear transfer functions, not room-seat
+    // captures.  They cannot be replayed by the physical-seat validator that
+    // proves a RoomEQ correction survived the final graph.  Keep generating
+    // the CTC artifact, but do not turn the missing room-seat evidence into an
+    // accepted acoustic claim (or fail the entire CTC artifact-producing run).
+    // When the same run also captured room seats, that evidence is replayable:
+    // fall through to the ordinary selection so the delivered RoomEQ graph is
+    // validated (and electrically attenuated) like any other, with the CTC
+    // artifact retained alongside it.
+    if result.metadata.ctc.is_some() && captures.is_empty() && held_out.is_empty() {
+        finish_ctc_without_room_seat_evidence(
+            result,
+            initial_safety_budget_checks,
+            initial_safety_budget_failure.as_deref(),
+        )?;
+        return Ok(());
+    }
+
+    // A direct caller with no captures has no evidence that can be replayed;
+    // preserve that explicit deferred outcome. Production routes attach the
+    // scorecard immediately before this call, while callers with captures are
+    // given the same evaluator here so the finalizer cannot bypass evidence.
+    if result.metadata.correction_acceptance.is_none() && captures.is_empty() && held_out.is_empty()
+    {
+        if let Some(failure) = initial_safety_budget_failure {
+            return Err(failed(format!(
+                "max_output_safety_attenuation_exceeded: {failure}; selection has no acceptance evidence"
+            )));
+        }
+        record_output_safety_attenuation_budget(result, initial_safety_budget_checks);
+        result.metadata.stage_outcomes.push(StageOutcome {
+            stage: "final_correction_selection".into(),
+            status: StageStatus::Skipped,
+            advisories: vec!["selection_without_acceptance_evidence_deferred".into()],
+            checks: Vec::new(),
+        });
+        return Ok(());
+    }
+    if result.metadata.correction_acceptance.is_none() {
+        if super::validation_scorecard::needs_native_routed_acceptance(result) {
+            refresh_configured_native_acceptance(result, config, fs, dir)?;
+            super::validation_scorecard::defer_native_routed_acceptance(result);
+        } else {
+            super::validation_scorecard::attach_validation_scorecard(
+                result,
+                held_out,
+                fs,
+                roomeq_model::auto_tune::resolved_schroeder_hz(&config.optimizer),
+                config.optimizer.processing_mode.clone(),
+            )?;
+        }
+    }
+    if result.metadata.correction_acceptance.is_none() {
+        result.metadata.stage_outcomes.push(StageOutcome {
+            stage: "final_correction_selection".into(),
+            status: StageStatus::Degraded,
+            advisories: vec!["final_acceptance_evidence=insufficient_evidence".into()],
+            checks: Vec::new(),
+        });
+        return Err(failed("final correction acceptance evidence unavailable"));
+    }
+
+    // A multi-branch physical replay needs a measured phase for every
+    // branch. Magnitude-only driver CSVs still support the magnitude EQ and
+    // export path, but they cannot prove coherent crossover summation or
+    // source timing. Publish the structural baseline and report that limitation
+    // explicitly instead of turning an evidence gap into a failed run (or
+    // inventing zero phase).
+    if seat_replay::has_unmeasured_multi_branch_phase(captures) {
+        return publish_baseline(
+            result,
+            captures,
+            held_out,
+            config,
+            fs,
+            dir,
+            store,
+            "final_seat_phase_evidence_insufficient",
+            Vec::new(),
+        );
+    }
+    let original = result.clone();
+    if let Some(capture) = diagnostics.as_deref_mut() {
+        capture.write(
+            "optimized-pre-finalization",
+            serde_json::json!({
+                "schema_version": 1,
+                "event": "optimized-pre-finalization",
+                "sample_rate_hz": fs,
+                "config": diagnostic_config_value(config),
+                "result": diagnostic_result_value(&original)?,
+            }),
+        );
+        capture.optimized_result = capture.failure.is_none();
+    }
+    // Strength changes cannot supply missing physical measurements, coherent
+    // phase, or artifact identities. Fail those evidence errors before doing
+    // expensive FIR trials; an ordinary acoustic rejection still gets refined.
+    let mut preflight = original.clone();
+    if original.metadata.correction_acceptance.is_some()
+        && let Err(
+            error @ (AutoeqError::InvalidMeasurement { .. }
+            | AutoeqError::InvalidConfiguration { .. }),
+        ) = seat_replay::validate_candidate_final_seats(
+            &mut preflight,
+            &original,
+            captures,
+            held_out,
+            config,
+            fs,
+            dir,
+        )
+    {
+        if error
+            .to_string()
+            .contains("insufficient summation evidence")
+            // Routed main/sub branches are not represented as grouped drivers
+            // in captures, so the earlier grouped-driver phase check cannot
+            // detect this case. Publish the same unverified baseline without
+            // inventing phase or treating malformed configuration as evidence.
+            || matches!(&error, AutoeqError::InvalidMeasurement { message }
+                if message == "final-seat coherent replay needs phase for every physical branch")
+        {
+            return publish_baseline(
+                result,
+                captures,
+                held_out,
+                config,
+                fs,
+                dir,
+                store,
+                &error.to_string(),
+                Vec::new(),
+            );
+        }
+        return Err(error);
+    }
+    let mut best: Option<(f64, RoomOptimizationResult)> = None;
+    let mut trials = Vec::new();
+    // The original and identity endpoints remain explicit. Intermediate trials
+    // preserve structural routing, crossover, polarity and alignment controls.
+    let strengths = [
+        1.0, 0.875, 0.75, 0.625, 0.5, 0.375, 0.25, 0.125, 0.0625, 0.03125, 0.0,
+    ];
+    // Preserve the sampled strengths, and add the exact branchwise point at
+    // the existing electrical backstop when the full correction exceeds it.
+    // Acceptance still rechecks the emitted graph after topology recalibration.
+    let electrical_boundary_strength = original
+        .metadata
+        .correction_acceptance
+        .as_ref()
+        .and_then(|report| report.runtime_policy.as_ref())
+        .and_then(|policy| {
+            let routes = original
+                .metadata
+                .bass_management
+                .as_ref()
+                .and_then(|bass| bass.routing_graph.as_ref())
+                .map(|graph| graph.routes.as_slice());
+            roomeq_playback::delay_compile::correction_strength_for_electrical_ceiling(
+                &original.channels,
+                routes,
+                policy.max_boost_db + 0.5,
+                roomeq_playback::delay_compile::applied_lfe_playback_gain_db(
+                    original.metadata.bass_management.as_ref(),
+                ),
+            )
+        })
+        .filter(|strength| *strength > 0.0 && *strength < 1.0);
+    let sub_roles: std::collections::BTreeSet<_> = original
+        .channels
+        .keys()
+        .filter(|name| is_subwoofer_channel(config, name))
+        .cloned()
+        .collect();
+    // Role-specific refinement is useful when a chain contains repeated
+    // correction sections (the cumulative-overcorrection case). Expanding it
+    // across every ordinary stereo/cinema run multiplies expensive final graph
+    // replays without changing the already-valid full-strength result.
+    let allow_role_refinement = !sub_roles.is_empty()
+        && sub_roles.len() < original.channels.len()
+        && original.channels.len() <= 3
+        && has_repeated_eq_sections(&original)
+        && !config
+            .optimizer
+            .excursion_protection
+            .as_ref()
+            .is_some_and(|protection| protection.enabled);
+    let mut parameters: Vec<_> = strengths
+        .into_iter()
+        .flat_map(|strength| {
+            [
+                (strength, strength, "output", 0.0),
+                (strength, strength, "common", 0.0),
+                (strength, strength, "spectral", 0.0),
+            ]
+        })
+        .collect();
+    if let Some(boundary) = electrical_boundary_strength {
+        parameters.extend([
+            (boundary, boundary, "output", 0.0),
+            (boundary, boundary, "common", 0.0),
+            (boundary, boundary, "spectral", 0.0),
+        ]);
+    }
+    // A main's correction and a shared sub array's correction affect different
+    // acoustic branches. Reducing both together can destroy a useful bass
+    // correction just to repair a main's target error or crossover rotation.
+    if allow_role_refinement {
+        for main_strength in strengths {
+            for sub_strength in strengths {
+                if main_strength != sub_strength {
+                    for mode in ["output", "common", "spectral"] {
+                        parameters.push((main_strength, sub_strength, mode, 0.0));
+                    }
+                }
+            }
+        }
+    }
+    let policy = &config.optimizer.finalization;
+    if policy.physical_drive_weight > 0.0 && !policy.subwoofer_limiter {
+        // Bounded search samples of the user's existing attenuation budget,
+        // not new permission to lose acoustic output or audibility thresholds.
+        // Include lower-drive alternatives even when every original is safe.
+        for strength in strengths {
+            for fraction in [1.0 / 64.0, 1.0 / 16.0, 0.25, 1.0] {
+                parameters.push((
+                    strength,
+                    strength,
+                    "common",
+                    policy.max_attenuation_db * fraction,
+                ));
+            }
+        }
+    }
+    // Array-stage diagnostics can outlive a safety reversion. Joint control
+    // trials must start from the realized, safety-rebuilt graph rather than
+    // proposing coordinates against historical controls that will be removed.
+    let joint_base = if config.optimizer.finalization.physical_drive_weight > 0.0 {
+        let mut baseline = original.clone();
+        rebuild(&mut baseline, config, held_out, fs, dir)
+            .ok()
+            .map(|()| baseline)
+    } else {
+        None
+    };
+    let joint_trials = joint_base
+        .as_ref()
+        .map(|baseline| joint_drive::proposals(baseline, config))
+        .transpose()?
+        .unwrap_or_default();
+    let without_post_eq = without_common_post_eq(&original);
+    let parameters: Vec<_> = parameters
+        .into_iter()
+        .map(|(main, sub, mode, cut)| (main, sub, mode, cut, None))
+        .chain(
+            joint_trials
+                .iter()
+                .enumerate()
+                .map(|(index, _)| (1.0, 1.0, "output", 0.0, Some(index))),
+        )
+        .collect();
+    let parameters: Vec<_> = parameters
+        .iter()
+        .copied()
+        .map(|parameters| (parameters, false))
+        .chain(without_post_eq.iter().flat_map(|_| {
+            parameters
+                .iter()
+                .copied()
+                .filter(|parameters| parameters.4.is_none())
+                .map(|parameters| (parameters, true))
+        }))
+        .collect();
+    let configured_comparison =
+        seat_replay::ConfiguredComparison::new(&original, captures, held_out, config, fs, dir);
+    let evaluation_context = TrialEvaluationContext {
+        configured_comparison: &configured_comparison,
+        original: &original,
+        captures,
+        held_out,
+        config,
+        fs,
+        dir,
+        store,
+        diagnostic_trial,
+        joint_trials: &joint_trials,
+        allow_role_refinement,
+        has_post_eq_alternative: without_post_eq.is_some(),
+    };
+    let started = std::time::Instant::now();
+    let mut last_progress = started;
+    log::info!(
+        "Finalization: evaluating up to {} candidates, including with/without Post-EQ={}",
+        parameters.len(),
+        without_post_eq.is_some()
+    );
+    let mut precomputed = evaluate_trial_schedule(
+        &evaluation_context,
+        &parameters,
+        &sub_roles,
+        joint_base.as_ref(),
+        without_post_eq.as_ref(),
+        diagnostics,
+    )?;
+    for (index, &((strength, sub_strength, attenuation_mode, _, _), omit_post_eq)) in
+        parameters.iter().enumerate()
+    {
+        if config.optimizer.finalization.subwoofer_limiter && attenuation_mode != "output" {
+            continue;
+        }
+        // Keep warning-only measured runs visibly alive during lengthy searches.
+        // At info level, report more frequently without flooding each trial.
+        let info_enabled = log::log_enabled!(log::Level::Info);
+        let interval = if info_enabled { 5 } else { 30 };
+        if last_progress.elapsed().as_secs() >= interval {
+            log::log!(
+                if info_enabled {
+                    log::Level::Info
+                } else {
+                    log::Level::Warn
+                },
+                "Finalization running: candidate {}/{}, elapsed {:.1}s, main strength={strength:.5}, sub strength={sub_strength:.5}, attenuation={attenuation_mode}, without Post-EQ={omit_post_eq}",
+                index + 1,
+                parameters.len(),
+                started.elapsed().as_secs_f64()
+            );
+            last_progress = std::time::Instant::now();
+        }
+        let evaluation = precomputed.remove(&index);
+        let Some(EvaluatedTrial {
+            candidate,
+            attempt,
+            check,
+            stop_after_trial: _,
+        }) = evaluation
+        else {
+            continue;
+        };
+        trials.push(check);
+        if let Ok(score) = attempt
+            && let Some(mut candidate) = candidate
+            && best
+                .as_ref()
+                .is_none_or(|(previous, _)| score < *previous - 1e-9)
+        {
+            candidate.metadata.stage_outcomes.push(StageOutcome {
+                stage: "final_correction_strength".into(),
+                status: StageStatus::Applied,
+                advisories: vec![
+                    format!("selected_strength={strength}"),
+                    format!("selected_sub_strength={sub_strength}"),
+                    format!("selected_without_post_eq={omit_post_eq}"),
+                    "attenuation_included_in_final_acoustic_acceptance".into(),
+                ],
+                checks: Vec::new(),
+            });
+            best = Some((score, candidate));
+        }
+    }
+    log::info!(
+        "Finalization: evaluated {} candidates in {:.1}s; passing candidate={}",
+        trials.len(),
+        started.elapsed().as_secs_f64(),
+        best.is_some()
+    );
+    // Joint route-delay search inside the authoritative replay. EQ rotates
+    // branch phase after topology selected its route delays, so when no
+    // strength candidate passes, re-search the main route delay on the
+    // full-strength graph and let the same configured replay, safety, and
+    // EPA gates judge every offset. No gate is relaxed; offsets that fail
+    // remain visible as rejected trials.
+    if best.is_none() {
+        for (strength, sub_strength) in
+            [(1.0, 1.0), (1.0, 0.5), (1.0, 0.45), (1.0, 0.4), (0.5, 1.0)]
+        {
+            for offset_ms in [-2.0, -1.0, -0.5, -0.25, 0.25, 0.5, 1.0, 2.0, 3.0, 4.0] {
+                if let Ok(mut shifted) = prepare_candidate(
+                    &original,
+                    (strength, sub_strength),
+                    &sub_roles,
+                    config,
+                    held_out,
+                    fs,
+                    dir,
+                    store,
+                ) {
+                    if shift_main_route_delays(&mut shifted.result, offset_ms).is_empty() {
+                        continue;
+                    }
+                    let evaluation = evaluate_prepared_trial(
+                        &evaluation_context,
+                        &Ok(shifted),
+                        ((strength, sub_strength, "output", 0.0, None), false),
+                        None,
+                    )?;
+                    if let Some(mut evaluation) = evaluation {
+                        evaluation.check.id =
+                            format!("{}_route_delay_{:+.2}ms", evaluation.check.id, offset_ms);
+                        let attempt = evaluation.attempt;
+                        trials.push(evaluation.check);
+                        if let Ok(score) = attempt
+                            && let Some(mut candidate) = evaluation.candidate
+                            && best
+                                .as_ref()
+                                .is_none_or(|(previous, _)| score < *previous - 1e-9)
+                        {
+                            candidate.metadata.stage_outcomes.push(StageOutcome {
+                                stage: "final_correction_strength".into(),
+                                status: StageStatus::Applied,
+                                advisories: vec![
+                                    format!("selected_strength={strength}"),
+                                    format!("selected_sub_strength={sub_strength}"),
+                                    format!("selected_route_delay_offset_ms={offset_ms:+.2}"),
+                                    "attenuation_included_in_final_acoustic_acceptance".into(),
+                                ],
+                                checks: Vec::new(),
+                            });
+                            best = Some((score, candidate));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let Some((_, mut selected)) = best else {
+        // A structural fallback can itself exceed the electrical limit. Keep
+        // the original candidate failures visible even if no artifact is saved.
+        for trial in trials.iter().filter(|trial| !trial.passed).take(3) {
+            log::warn!(
+                "Final correction candidate {} rejected: {}",
+                trial.id,
+                trial.diagnostic.as_deref().unwrap_or("no diagnostic")
+            );
+        }
+        return publish_baseline(
+            result,
+            captures,
+            held_out,
+            config,
+            fs,
+            dir,
+            store,
+            "no_candidate_within_electrical_acoustic_limits",
+            trials,
+        );
+    };
+    // A joint-sub chain already carries an independently accepted array
+    // optimization. Metric identity in finalization only means no further
+    // correction was selected; it must not erase that array as if the
+    // delivered graph were the correction-free structural baseline.
+    let keeps_accepted_joint_array = selected
+        .channels
+        .values()
+        .any(|chain| chain.joint_sub.is_some());
+    if !keeps_accepted_joint_array
+        && selected
+            .metadata
+            .correction_acceptance
+            .as_ref()
+            .is_some_and(|report| {
+                report.decision == roomeq_model::CorrectionDecision::IdentityFallback
+                    && is_identity_correction(&report.metrics)
+                    && report.acoustic_quality.as_ref().is_some_and(|quality| {
+                        !quality
+                            .training
+                            .configured_baseline
+                            .as_ref()
+                            .is_some_and(configured_reference_changed)
+                            && !quality
+                                .held_out
+                                .as_ref()
+                                .and_then(|partition| partition.configured_baseline.as_ref())
+                                .is_some_and(configured_reference_changed)
+                    })
+            })
+    {
+        // A zero-strength trial can retain unity EQ/FIR kernels. Publish the
+        // actual correction-free baseline, with freshly replayed safety,
+        // instead of shipping those needless kernels as an identity result.
+        // When the configured baseline already sits below every improvement
+        // floor, no candidate could demonstrate meaningful improvement:
+        // unchanged playback is then an approval, not a failed correction,
+        // so the reason is kept as an advisory without the violation.
+        // Approval also requires that the incoming graph proposed no
+        // correction: discarding a proposed correction (for example one
+        // reverted over electrical limits) must stay visible as a
+        // violation instead of reading as an approved unchanged result.
+        let discards_proposed_correction = result
+            .channels
+            .values()
+            .any(|chain| !super::room_optimization_result::correction_stages(chain).is_empty());
+        let approved_unchanged = !discards_proposed_correction
+            && selected
+                .metadata
+                .correction_acceptance
+                .as_ref()
+                .is_some_and(|report| configured_baseline_below_improvement_floors(report, policy));
+        let published = publish_baseline(
+            result,
+            captures,
+            held_out,
+            config,
+            fs,
+            dir,
+            store,
+            "no_candidate_with_meaningful_improvement",
+            trials,
+        );
+        if approved_unchanged
+            && published.is_ok()
+            && let Some(report) = result.metadata.correction_acceptance.as_mut()
+        {
+            report
+                .violations
+                .retain(|violation| violation != "no_candidate_with_meaningful_improvement");
+            report.refresh_outcome();
+        }
+        return published;
+    }
+    let mut selection_advisories = vec![
+        "all_candidates_compared_against_fixed_structural_baseline".to_string(),
+        "selection_score_basis=configured_routing_unprocessed_captures_v1".into(),
+        format!(
+            "benefit_floor_db={:.3}",
+            policy.min_improvement_lower_bound_db
+        ),
+        format!(
+            "primary_improvement_floor_db={:.3}",
+            policy.min_primary_improvement_db
+        ),
+    ];
+    if roomeq_playback::routed::crossover_timing_refused(
+        selected
+            .metadata
+            .bass_management
+            .as_ref()
+            .and_then(|bass| bass.optimization.as_ref()),
+    ) {
+        selection_advisories
+            .push(roomeq_playback::routed::CROSSOVER_CANCELLATION_UNASSESSED_ADVISORY.to_string());
+    }
+    selected.metadata.stage_outcomes.push(StageOutcome {
+        stage: "final_correction_selection".into(),
+        status: StageStatus::Applied,
+        advisories: selection_advisories,
+        checks: trials,
+    });
+    canonicalize_common_driver_delays(&mut selected);
+    *result = selected;
+    Ok(())
+}
+
+/// Move delay common to every driver of a channel onto the channel chain.
+///
+/// An advance trial realizes relative timing by delaying the other
+/// drivers, which leaves a delay component shared by the whole channel.
+/// That common part is channel latency, not per-driver steering: moving
+/// it to a plain chain delay keeps every driver's absolute timing (and
+/// therefore every rendered response) unchanged while keeping per-driver
+/// plugins in relative form.
+fn canonicalize_common_driver_delays(result: &mut RoomOptimizationResult) {
+    for chain in result.channels.values_mut() {
+        let Some(drivers) = &mut chain.drivers else {
+            continue;
+        };
+        if drivers.len() < 2 {
+            continue;
+        }
+        let totals: Vec<f64> = drivers
+            .iter()
+            .map(|driver| {
+                driver
+                    .plugins
+                    .iter()
+                    .filter(|plugin| plugin.plugin_type == "delay")
+                    .filter_map(|plugin| {
+                        plugin
+                            .parameters
+                            .get("delay_ms")
+                            .and_then(serde_json::Value::as_f64)
+                            .filter(|value| value.is_finite() && *value >= 0.0)
+                    })
+                    .sum()
+            })
+            .collect();
+        let common = totals.iter().copied().fold(f64::INFINITY, f64::min);
+        if !common.is_finite() || common <= 1e-9 {
+            continue;
+        }
+        for driver in drivers.iter_mut() {
+            let mut remaining = common;
+            driver.plugins.retain_mut(|plugin| {
+                if plugin.plugin_type != "delay" || remaining <= 1e-9 {
+                    return true;
+                }
+                let Some(delay) = plugin
+                    .parameters
+                    .get("delay_ms")
+                    .and_then(serde_json::Value::as_f64)
+                    .filter(|value| value.is_finite() && *value >= 0.0)
+                else {
+                    return true;
+                };
+                let reduced = delay - remaining.min(delay);
+                remaining -= remaining.min(delay);
+                if reduced <= 1e-9 {
+                    return false;
+                }
+                plugin.parameters["delay_ms"] = serde_json::json!(reduced);
+                true
+            });
+        }
+        chain
+            .plugins
+            .insert(0, roomeq_engine::output::create_delay_plugin(common));
+        if chain.joint_sub.is_some() {
+            roomeq_model::joint_sub_report::refresh_joint_sub_binding(chain);
+        }
+    }
+}
+
+struct TrialEvaluationContext<'a> {
+    configured_comparison: &'a seat_replay::ConfiguredComparison<'a>,
+    original: &'a RoomOptimizationResult,
+    captures: &'a [seat_replay::Capture],
+    held_out: &'a HashMap<String, Vec<Curve>>,
+    config: &'a RoomConfig,
+    fs: f64,
+    dir: &'a Path,
+    store: &'a dyn autoeq_artifacts::ArtifactStore,
+    diagnostic_trial: Option<roomeq_workflow_contracts::FinalizationDiagnosticTrial>,
+    joint_trials: &'a [joint_drive::JointTrial],
+    allow_role_refinement: bool,
+    has_post_eq_alternative: bool,
+}
+
+type TrialParameters = ((f64, f64, &'static str, f64, Option<usize>), bool);
+
+struct EvaluatedTrial {
+    candidate: Option<RoomOptimizationResult>,
+    attempt: Result<f64>,
+    check: StageCheck,
+    stop_after_trial: bool,
+}
+
+/// Visit coarse strengths before fine strengths, preserving every sampled point.
+fn strength_search_level(strength: f64) -> usize {
+    if strength == 1.0 {
+        0
+    } else if strength == 0.5 || strength == 0.0 {
+        1
+    } else if strength == 0.75 || strength == 0.25 {
+        2
+    } else if [0.875, 0.625, 0.375, 0.125].contains(&strength) {
+        3
+    } else {
+        4
+    }
+}
+
+fn trial_search_level(parameters: TrialParameters) -> (usize, usize) {
+    let ((main, sub, _, _, joint), omit) = parameters;
+    (
+        usize::from(joint.is_some() || omit),
+        strength_search_level(main).max(strength_search_level(sub)),
+    )
+}
+
+/// Prepare one strength graph once and validate its attenuation alternatives.
+fn evaluate_trial_group(
+    context: &TrialEvaluationContext<'_>,
+    group: &[(usize, TrialParameters)],
+    sub_roles: &std::collections::BTreeSet<String>,
+    joint_base: Option<&RoomOptimizationResult>,
+    without_post_eq: Option<&RoomOptimizationResult>,
+    mut diagnostics: Option<&mut FinalizationDiagnosticCapture<'_>>,
+) -> Result<Vec<(usize, EvaluatedTrial)>> {
+    let ((strength, sub_strength, _, _, joint_trial), omit_post_eq) = group[0].1;
+    let joint_source = joint_trial
+        .map(|index| context.joint_trials[index].apply(joint_base.expect("joint trial baseline")))
+        .transpose()?;
+    let source = joint_source.as_ref().unwrap_or_else(|| {
+        if omit_post_eq {
+            without_post_eq.expect("Post-EQ alternative")
+        } else {
+            context.original
+        }
+    });
+    let prepared = prepare_candidate(
+        source,
+        (strength, sub_strength),
+        sub_roles,
+        context.config,
+        context.held_out,
+        context.fs,
+        context.dir,
+        context.store,
+    )
+    .map_err(|error| error.to_string());
+    let mut evaluations = Vec::new();
+    for &(index, parameters) in group {
+        if let Some(evaluation) =
+            evaluate_prepared_trial(context, &prepared, parameters, diagnostics.as_deref_mut())?
+        {
+            let stop = evaluation.attempt.is_ok() && evaluation.stop_after_trial;
+            evaluations.push((index, evaluation));
+            if stop {
+                break;
+            }
+        }
+    }
+    Ok(evaluations)
+}
+
+/// Evaluate bounded parallel batches and reduce winners in original trial order.
+fn evaluate_trial_schedule(
+    context: &TrialEvaluationContext<'_>,
+    parameters: &[TrialParameters],
+    sub_roles: &std::collections::BTreeSet<String>,
+    joint_base: Option<&RoomOptimizationResult>,
+    without_post_eq: Option<&RoomOptimizationResult>,
+    mut diagnostics: Option<&mut FinalizationDiagnosticCapture<'_>>,
+) -> Result<std::collections::BTreeMap<usize, EvaluatedTrial>> {
+    use rayon::prelude::*;
+    let mut groups: Vec<Vec<(usize, TrialParameters)>> = Vec::new();
+    for (index, &parameters) in parameters.iter().enumerate() {
+        let ((main, sub, mode, _, joint), omit) = parameters;
+        if context.config.optimizer.finalization.subwoofer_limiter && mode != "output" {
+            continue;
+        }
+        let key = (main, sub, joint, omit);
+        if let Some(group) = groups.last_mut()
+            && let ((old_main, old_sub, _, _, old_joint), old_omit) = group[0].1
+            && key == (old_main, old_sub, old_joint, old_omit)
+        {
+            group.push((index, parameters));
+        } else {
+            groups.push(vec![(index, parameters)]);
+        }
+    }
+    groups.sort_by_key(|group| (trial_search_level(group[0].1), group[0].0));
+    // Four strength groups bound active FIR/metadata memory; one group preserves the
+    // inexpensive full-strength early exit before launching any extra work.
+    const MAX_PARALLEL_GRAPHS: usize = 4;
+    let width = std::thread::available_parallelism()
+        .map_or(1, |width| width.get())
+        .min(MAX_PARALLEL_GRAPHS);
+    let mut evaluations: std::collections::BTreeMap<usize, EvaluatedTrial> =
+        std::collections::BTreeMap::new();
+    let mut winner: Option<(f64, usize)> = None;
+    let mut next = 0;
+    let mut last_progress = std::time::Instant::now();
+    while next < groups.len() {
+        let mut end = (next + if next == 0 { 1 } else { width }).min(groups.len());
+        // Finish the current coarse level before starting a finer level.
+        // This preserves the validated negligible-residual early exit.
+        while end > next + 1
+            && trial_search_level(groups[end - 1][0].1) != trial_search_level(groups[next][0].1)
+        {
+            end -= 1;
+        }
+        let batch: Vec<_> = if diagnostics.is_some() {
+            groups[next..end]
+                .iter()
+                .map(|group| {
+                    evaluate_trial_group(
+                        context,
+                        group,
+                        sub_roles,
+                        joint_base,
+                        without_post_eq,
+                        diagnostics.as_deref_mut(),
+                    )
+                })
+                .collect()
+        } else {
+            groups[next..end]
+                .par_iter()
+                .map(|group| {
+                    evaluate_trial_group(
+                        context,
+                        group,
+                        sub_roles,
+                        joint_base,
+                        without_post_eq,
+                        None,
+                    )
+                })
+                .collect()
+        };
+        let mut stop = false;
+        for group in batch {
+            for (index, mut evaluation) in group? {
+                stop |= evaluation.attempt.is_ok() && evaluation.stop_after_trial;
+                let better = evaluation.attempt.as_ref().is_ok_and(|score| {
+                    winner.is_none_or(|(previous, previous_index)| {
+                        *score < previous - 1e-9
+                            || ((*score - previous).abs() <= 1e-9 && index < previous_index)
+                    })
+                });
+                if better {
+                    if let Some((_, previous_index)) = winner {
+                        evaluations
+                            .get_mut(&previous_index)
+                            .expect("previous winner")
+                            .candidate = None;
+                    }
+                    winner = Some((
+                        *evaluation.attempt.as_ref().expect("finite winning score"),
+                        index,
+                    ));
+                } else {
+                    // Keep every gate diagnostic, but only one complete winning
+                    // graph between batches; retained IR metadata can be large.
+                    evaluation.candidate = None;
+                }
+                evaluations.insert(index, evaluation);
+            }
+        }
+        next = end;
+        if last_progress.elapsed().as_secs() >= 30 {
+            log::warn!(
+                "Finalization running: completed {next}/{} strength groups",
+                groups.len()
+            );
+            last_progress = std::time::Instant::now();
+        }
+        if stop {
+            break;
+        }
+    }
+    Ok(evaluations)
+}
+
+/// Validate one delivered candidate without changing selection state.
+fn evaluate_prepared_trial(
+    context: &TrialEvaluationContext<'_>,
+    prepared: &std::result::Result<PreparedCandidate, String>,
+    parameters: TrialParameters,
+    mut diagnostics: Option<&mut FinalizationDiagnosticCapture<'_>>,
+) -> Result<Option<EvaluatedTrial>> {
+    let TrialEvaluationContext {
+        configured_comparison,
+        original,
+        captures,
+        held_out,
+        config,
+        fs,
+        dir,
+        store,
+        diagnostic_trial,
+        joint_trials,
+        allow_role_refinement,
+        has_post_eq_alternative,
+    } = *context;
+    let ((strength, sub_strength, attenuation_mode, drive_cut_db, joint_trial), omit_post_eq) =
+        parameters;
+    // With no required attenuation the three modes produce the same DSP.
+    // Evaluate that candidate once, including its final level alignment.
+    if attenuation_mode != "output"
+        && drive_cut_db == 0.0
+        && prepared.as_ref().is_ok_and(|value| {
+            value
+                .physical
+                .values()
+                .all(|value| value.attenuation_db == 0.0)
+                && value.electrical.iter().all(|output| {
+                    output.peak_dbfs.is_none_or(|peak| {
+                        peak <= config.optimizer.finalization.output_ceiling_dbfs + 1e-6
+                    })
+                })
+        })
+    {
+        return Ok(None);
+    }
+    let mut candidate = prepared
+        .as_ref()
+        .map(|value| value.result.clone())
+        .unwrap_or_else(|_| original.clone());
+    let diagnostic_strength = match diagnostic_trial {
+        Some(roomeq_workflow_contracts::FinalizationDiagnosticTrial::ZeroStrengthOutput) => Some(0.0),
+        Some(roomeq_workflow_contracts::FinalizationDiagnosticTrial::FullStrengthOutput) => Some(1.0),
+        None => None,
+    };
+    let diagnostic_prefix = if diagnostic_strength == Some(1.0) {
+        "full-strength-output"
+    } else {
+        "zero-strength-output"
+    };
+    let capture_target = diagnostics.is_some()
+        && diagnostic_strength == Some(strength)
+        && diagnostic_strength == Some(sub_strength)
+        && attenuation_mode == "output"
+        && drive_cut_db == 0.0
+        && joint_trial.is_none()
+        && !omit_post_eq;
+    let trial_descriptor = capture_target.then(|| {
+        serde_json::json!({
+            "schema_version": 1,
+            "trial": if diagnostic_strength == Some(1.0) { "full_strength_output" } else { "zero_strength_output" },
+            "correction_strength": strength,
+            "sub_correction_strength": sub_strength,
+            "attenuation_mode": attenuation_mode,
+            "drive_cut_db": drive_cut_db,
+            "joint_trial_index": joint_trial,
+            "omit_post_eq": omit_post_eq,
+        })
+    });
+    if capture_target && let Some(capture) = diagnostics.as_deref_mut() {
+        capture.target_trial_descriptor = trial_descriptor.clone();
+    }
+    if capture_target
+        && let Some(capture) = diagnostics.as_deref_mut()
+        && let Ok(prepared) = &prepared
+    {
+        let graph_hashes = diagnostic_graph_hashes(&prepared.result)?;
+        capture.write(
+            &format!("{diagnostic_prefix}-prepared"),
+            serde_json::json!({
+                "schema_version": 1,
+                "event": &format!("{diagnostic_prefix}-prepared"),
+                "trial_descriptor": trial_descriptor.as_ref(),
+                "serialized_dsp_graph_projection_sha256":
+                    graph_hashes.serialized_projection_sha256,
+                "playback_graph_sha256": graph_hashes.playback_projection_sha256,
+                "strength": strength,
+                "sub_strength": sub_strength,
+                "result": diagnostic_result_value(&prepared.result)?,
+                "electrical": &prepared.electrical,
+                    "physical_requirements": physical_requirements_value(&prepared.physical),
+            }),
+        );
+        capture.prepared_candidate = capture.failure.is_none();
+    }
+    let mut stop_after_trial = false;
+    let mut failure_checks = Vec::new();
+    // Gate refresh may replace or remove stage entries, so a positional
+    // boundary would skip new checks after the vector shrinks.
+    let initial_stage_checks: Vec<_> = candidate
+        .metadata
+        .stage_outcomes
+        .iter()
+        .flat_map(|stage| &stage.checks)
+        .filter(|check| {
+            !check.passed
+                && matches!(
+                    check.kind,
+                    StageCheckKind::Safety | StageCheckKind::Structural
+                )
+        })
+        .cloned()
+        .collect();
+    let attempt = (|| -> Result<f64> {
+        let policy = &config.optimizer.finalization;
+        let before = &prepared
+            .as_ref()
+            .map_err(|error| failed(error.clone()))?
+            .electrical;
+        let protected = sub_output_limiter::protected_outputs(&candidate, policy)?;
+        let before: Vec<_> = before
+            .iter()
+            .filter(|output| !protected.contains(&output.output))
+            .cloned()
+            .collect();
+        let physical = &prepared
+            .as_ref()
+            .map_err(|error| failed(error.clone()))?
+            .physical;
+        let required =
+            physical_drive::combined_attenuations(&before, physical, policy.output_ceiling_dbfs);
+        log::debug!(
+            "trial strength={strength:.5} sub={sub_strength:.5} mode={attenuation_mode} required_attenuation={required:?}"
+        );
+        if capture_target && let Some(capture) = diagnostics.as_deref_mut() {
+            let graph_hashes = diagnostic_graph_hashes(&candidate)?;
+            capture.write(
+                &format!("{diagnostic_prefix}-required-attenuation"),
+                serde_json::json!({
+                    "schema_version": 1,
+                    "event": &format!("{diagnostic_prefix}-required-attenuation"),
+                    "trial_descriptor": trial_descriptor.as_ref(),
+                    "serialized_dsp_graph_projection_sha256":
+                        graph_hashes.serialized_projection_sha256,
+                    "playback_graph_sha256": graph_hashes.playback_projection_sha256,
+                    "electrical_before_protection": &before,
+                    "physical_requirements": physical_requirements_value(physical),
+                    "protected_outputs": &protected,
+                    "required_attenuation_db_by_output": &required,
+                    "output_ceiling_dbfs": policy.output_ceiling_dbfs,
+                }),
+            );
+            capture.required_attenuation = capture.failure.is_none();
+        }
+        let attenuation = required.values().copied().fold(0.0_f64, f64::max) + drive_cut_db;
+        let safety_gate = CorrectionSafetyGateContext {
+            config,
+            sample_rate: fs,
+            smoothing_n: config.optimizer.smooth_n,
+            evaluation_band: (config.optimizer.min_freq, config.optimizer.max_freq),
+            sidecar_dir: dir,
+            processing_mode: config.optimizer.processing_mode.clone(),
+            group_delay_budget_ms: group_delay_budget_ms(config),
+        };
+        apply_trial_output_attenuation_and_safety_gate(
+            &mut candidate,
+            &required,
+            physical.values().any(|value| value.attenuation_db > 0.0),
+            attenuation_mode,
+            attenuation,
+            &safety_gate,
+        )?;
+        if capture_target && let Some(capture) = diagnostics.as_deref_mut() {
+            let graph_hashes = diagnostic_graph_hashes(&candidate)?;
+            capture.write(
+                &format!("{diagnostic_prefix}-post-safety-pre-alignment"),
+                serde_json::json!({
+                    "schema_version": 1,
+                    "event": &format!("{diagnostic_prefix}-post-safety-pre-alignment"),
+                    "trial_descriptor": trial_descriptor.as_ref(),
+                    "serialized_dsp_graph_projection_sha256":
+                        graph_hashes.serialized_projection_sha256,
+                    "playback_graph_sha256": graph_hashes.playback_projection_sha256,
+                    "result": diagnostic_result_value(&candidate)?,
+                    "required_attenuation_db_by_output": &required,
+                }),
+            );
+            capture.post_safety_candidate = capture.failure.is_none();
+        }
+        // Strength and output attenuation can change role-pair levels.
+        // Reapply the configured alignment to this complete candidate,
+        // then verify electrical limits again with those gains included.
+        let alignment = apply_final_channel_level_alignment(&mut candidate, config, fs, dir)?;
+        if alignment.checks.iter().any(|check| !check.passed) {
+            return Err(failed("final candidate channel-level alignment failed"));
+        }
+        let alignment_diagnostic = capture_target.then(|| alignment.clone());
+        candidate.metadata.stage_outcomes.retain(|stage| {
+            stage.stage != "final_channel_level_alignment"
+                && stage.stage != "channel_level_candidate_requires_final_refinement"
+        });
+        candidate.metadata.stage_outcomes.push(alignment);
+        let safety_budget_checks = output_safety_attenuation_budget_checks(&candidate, config)?;
+        if let Some(failure) = output_safety_attenuation_failure(&safety_budget_checks) {
+            return Err(failed(format!(
+                "max_output_safety_attenuation_exceeded: {failure}"
+            )));
+        }
+        record_output_safety_attenuation_budget(&mut candidate, safety_budget_checks);
+        if let Some(bass) = &candidate.metadata.bass_management
+            && let Some(graph) = &bass.routing_graph
+        {
+            // Without calibrated main/sub timing the coherent splice
+            // verdict is arbitrary: reconstruct without enforcement and
+            // record the skipped assessment on selection instead of
+            // rejecting corrections on luck.
+            let timing_refused =
+                roomeq_playback::routed::crossover_timing_refused(bass.optimization.as_ref());
+            let (curves, cancellation) = if timing_refused {
+                (
+                    roomeq_playback::routed::reconstruct_deployed_source_curves_unenforced(
+                        &candidate.channels,
+                        &retained_fir_coeffs_by_channel(&candidate),
+                        graph,
+                        bass.optimization.as_ref(),
+                        fs,
+                        dir,
+                    )?,
+                    Vec::new(),
+                )
+            } else {
+                roomeq_playback::routed::reconstruct_deployed_source_curves_with_evidence(
+                    &candidate.channels,
+                    &retained_fir_coeffs_by_channel(&candidate),
+                    graph,
+                    bass.optimization.as_ref(),
+                    fs,
+                    dir,
+                )?
+            };
+            candidate.deployed_source_curves = curves;
+            candidate
+                .metadata
+                .bass_management
+                .as_mut()
+                .unwrap()
+                .crossover_cancellation = cancellation;
+        }
+        let outputs = roomeq_playback::electrical_headroom::assess_final_graph(
+            &candidate.to_dsp_chain_output(),
+            fs,
+            dir,
+            policy,
+        )?;
+        let protected = sub_output_limiter::protected_outputs(&candidate, policy)?;
+        if outputs
+            .iter()
+            .filter(|output| !protected.contains(&output.output))
+            .any(|output| {
+                output
+                    .peak_dbfs
+                    .is_some_and(|peak| peak > policy.output_ceiling_dbfs + 1e-6)
+            })
+        {
+            return Err(failed(
+                "final electrical replay exceeds configured output ceiling",
+            ));
+        }
+        let drive_utilization = verify_declared_physical_drive(&mut candidate, config, fs, dir)?;
+        let post_alignment_hashes = capture_target
+            .then(|| diagnostic_graph_hashes(&candidate))
+            .transpose()?;
+        if capture_target && let Some(capture) = diagnostics.as_deref_mut() {
+            capture.target_trial_post_alignment_hashes = post_alignment_hashes.clone();
+            let alignment_gains = candidate
+                .channels
+                .iter()
+                .filter_map(|(name, chain)| {
+                    let gains: Vec<_> = chain
+                        .plugins
+                        .iter()
+                        .filter(|plugin| {
+                            plugin
+                                .parameters
+                                .get("label")
+                                .and_then(serde_json::Value::as_str)
+                                == Some("final_channel_level_alignment")
+                        })
+                        .cloned()
+                        .collect();
+                    (!gains.is_empty()).then_some((name.clone(), gains))
+                })
+                .collect::<std::collections::BTreeMap<_, _>>();
+            capture.write(
+                &format!("{diagnostic_prefix}-post-alignment"),
+                serde_json::json!({
+                    "schema_version": 1,
+                    "event": &format!("{diagnostic_prefix}-post-alignment"),
+                    "trial_descriptor": trial_descriptor.as_ref(),
+                    "serialized_dsp_graph_projection_sha256": post_alignment_hashes
+                        .as_ref()
+                        .map(|hashes| &hashes.serialized_projection_sha256),
+                    "playback_graph_sha256": post_alignment_hashes
+                        .as_ref()
+                        .map(|hashes| &hashes.playback_projection_sha256),
+                    "result": diagnostic_result_value(&candidate)?,
+                    "alignment_outcome": alignment_diagnostic,
+                    "tagged_alignment_plugins_by_channel": alignment_gains,
+                    "electrical_outputs": &outputs,
+                    "physical_drive_utilization": &drive_utilization,
+                }),
+            );
+            capture.post_alignment_candidate = capture.failure.is_none();
+        }
+        // Do not reuse a pre-attenuation or representative-seat verdict.
+        let seat_validation = if capture_target {
+            let mut replay_trace = Vec::new();
+            let validation = seat_replay::validate_candidate_final_seats_with_diagnostic_trace(
+                &mut candidate,
+                original,
+                captures,
+                held_out,
+                config,
+                fs,
+                dir,
+                &mut replay_trace,
+            );
+            if let Some(graph_hashes) = &post_alignment_hashes {
+                for record in &mut replay_trace {
+                    record.replayed_serialized_dsp_graph_projection_sha256 =
+                        Some(graph_hashes.serialized_projection_sha256.clone());
+                    record.replayed_playback_graph_sha256 =
+                        Some(graph_hashes.playback_projection_sha256.clone());
+                }
+            }
+            if let Some(capture) = diagnostics.as_deref_mut() {
+                capture.write(
+                    &format!("{diagnostic_prefix}-useful-output-replay"),
+                    serde_json::json!({
+                        "schema_version": 1,
+                        "event": &format!("{diagnostic_prefix}-useful-output-replay"),
+                        "trial_descriptor": trial_descriptor.as_ref(),
+                        "replayed_serialized_dsp_graph_projection_sha256": post_alignment_hashes
+                            .as_ref()
+                            .map(|hashes| &hashes.serialized_projection_sha256),
+                        "replayed_playback_graph_sha256": post_alignment_hashes
+                            .as_ref()
+                            .map(|hashes| &hashes.playback_projection_sha256),
+                        "replay_records": replay_trace,
+                        "validation_error": validation.as_ref().err().map(ToString::to_string),
+                    }),
+                );
+                capture.useful_output_replay =
+                    capture.failure.is_none() && !replay_trace.is_empty();
+            }
+            validation
+        } else {
+            seat_replay::validate_candidate_final_seats(
+                &mut candidate,
+                original,
+                captures,
+                held_out,
+                config,
+                fs,
+                dir,
+            )
+        };
+        if let Some(report) = candidate.metadata.correction_acceptance.as_ref() {
+            failure_checks = roomeq_engine::quality::runtime_acceptance_failure_checks(report);
+            if report
+                .violations
+                .iter()
+                .any(|violation| violation == "unexplained_useful_output_loss")
+                && let Some(quality) = report.acoustic_quality.as_ref()
+            {
+                for output in &quality.useful_output {
+                    let subwoofer = output.logical_input.as_deref().is_some_and(|input| {
+                        let key = config
+                            .system
+                            .as_ref()
+                            .and_then(|system| system.speakers.get(input))
+                            .map(String::as_str)
+                            .unwrap_or(input);
+                        is_subwoofer_channel(config, input)
+                            || matches!(
+                                config.speakers.get(key),
+                                Some(
+                                    SpeakerConfig::MultiSub(_)
+                                        | SpeakerConfig::Dba(_)
+                                        | SpeakerConfig::Cardioid(_)
+                                )
+                            )
+                    });
+                    let loss = output
+                        .unexplained_loss_rms_db
+                        .max(output.bass_unexplained_loss_rms_db.unwrap_or(0.0));
+                    if !subwoofer && loss > policy.max_useful_output_loss_db {
+                        failure_checks.push(failed_numeric_margin(
+                            &format!(
+                                "useful_output_{}_{}_seat_{}",
+                                output.partition,
+                                output.logical_input.as_deref().unwrap_or("unknown"),
+                                output.seat_index
+                            ),
+                            loss,
+                            policy.max_useful_output_loss_db,
+                            MarginBoundary::Maximum,
+                        ));
+                    }
+                }
+            }
+        }
+        seat_validation?;
+        configured_comparison.attach(&mut candidate);
+        let configured_metrics = seat_replay::configured_selection_metrics(
+            candidate
+                .metadata
+                .correction_acceptance
+                .as_ref()
+                .ok_or_else(|| failed("configured selection acceptance unavailable"))?,
+        )
+        .map_err(|error| failed(error.to_string()))?;
+        let report = candidate
+            .metadata
+            .correction_acceptance
+            .as_mut()
+            .ok_or_else(|| failed("final correction acceptance unavailable"))?;
+        super::validation_scorecard::align_report_metrics_to_scorecard(report);
+        let accepted_via_safe_reversion = matches!(
+            report.decision,
+            roomeq_model::CorrectionDecision::RevertedStage
+                | roomeq_model::CorrectionDecision::IdentityFallback
+        );
+        let only_reversion_history = report
+            .violations
+            .iter()
+            .all(|violation| violation == "audibility_regression_reverted");
+        if (!report.accepted && !accepted_via_safe_reversion)
+            || (accepted_via_safe_reversion && !only_reversion_history)
+        {
+            return Err(failed(format!(
+                "final correction policy rejected: {:?}",
+                report.violations
+            )));
+        }
+        // Passing vetoes is necessary but does not establish improvement.
+        // A realized identity is unchanged; a nonidentity candidate must
+        // improve the declared primary metric beyond the engineering
+        // selection floor. This does not claim a listening threshold.
+        // Joint array refinements are the exception: their purpose is the
+        // physical-drive trade the candidate score already prices, and
+        // their marginal acoustic effect can legitimately be small. They
+        // are judged by the per-seat benefit floor below (every training
+        // seat must still improve beyond uncertainty), never by the
+        // identity loophole, and all regression budgets still apply.
+        // A pure broadband level change (a drive-cut trial, safety
+        // attenuation) reads as zero centered correction, but it is a
+        // real playback change, not an identity: the configured
+        // comparison's recorded post-reference gain proves it.
+        let configured_unchanged = report.acoustic_quality.as_ref().is_some_and(|quality| {
+            !quality
+                .training
+                .configured_baseline
+                .as_ref()
+                .is_some_and(configured_reference_changed)
+                && !quality
+                    .held_out
+                    .as_ref()
+                    .and_then(|partition| partition.configured_baseline.as_ref())
+                    .is_some_and(configured_reference_changed)
+        });
+        let identity_candidate = joint_trial.is_none()
+            && is_identity_correction(&report.metrics)
+            && configured_unchanged;
+        if !configured_metrics.training_improvement_db.is_finite()
+            || configured_metrics.training_improvement_db
+                <= policy.min_primary_improvement_db.max(1e-6)
+        {
+            if identity_candidate {
+                report.accepted = false;
+                report.decision = roomeq_model::CorrectionDecision::IdentityFallback;
+                report.refresh_outcome();
+            } else if joint_trial.is_some()
+                && configured_metrics.training_improvement_db.is_finite()
+            {
+                // Defer to the per-seat benefit floor below.
+            } else {
+                failure_checks.push(failed_numeric_margin(
+                    "primary_improvement_below_floor",
+                    configured_metrics.training_improvement_db,
+                    policy.min_primary_improvement_db.max(1e-6),
+                    MarginBoundary::ExclusiveMinimum,
+                ));
+                return Err(failed(format!(
+                    "configured whole-playback metric did not reach meaningful improvement: improvement_db={:.9}, minimum_improvement_db={:.9}, correction_rms_db={:.9}, max_abs_correction_db={:.9}",
+                    configured_metrics.training_improvement_db,
+                    policy.min_primary_improvement_db,
+                    report.metrics.correction_rms_db,
+                    report.metrics.max_abs_correction_db,
+                )));
+            }
+        } else if accepted_via_safe_reversion {
+            // The stage reversion is historical: this exact remaining DSP
+            // has now passed electrical, crossover, alignment, every-seat,
+            // output-preservation and primary-improvement checks. Keep the
+            // reverted stages for diagnostics, not as a stale veto.
+            report.accepted = true;
+            report.decision = roomeq_model::CorrectionDecision::Accepted;
+            report.violations.clear();
+            report.refresh_outcome();
+        }
+        let quality = report
+            .acoustic_quality
+            .as_mut()
+            .ok_or_else(|| failed("final acoustic evidence unavailable"))?;
+        if quality.final_seats.is_empty() {
+            return Err(failed("final physical-seat evidence unavailable"));
+        }
+        // WP5a benefit floor: every training seat of a non-identity
+        // candidate must improve beyond measurement uncertainty, or the
+        // candidate shows no demonstrated benefit and selection prefers
+        // a simpler protected result. Identity candidates skip the
+        // floor: with no correction applied there is nothing to
+        // reject, and they flow through as the protected baseline.
+        // Joint refinements never skip it: a centered metric can read a
+        // level-changing array trim as zero correction, but the trim is
+        // a real graph change that must demonstrate seat benefit.
+        if joint_trial.is_some() || !is_identity_correction(&report.metrics) {
+            let benefit = training_seats_show_benefit(
+                &quality.final_seats,
+                policy.min_improvement_lower_bound_db,
+            );
+            if benefit.is_err() {
+                for seat in quality.final_seats.iter().filter(|seat| {
+                    seat.partition == "training"
+                        && seat
+                            .improvement_lower_bound_db
+                            .partial_cmp(&policy.min_improvement_lower_bound_db)
+                            != Some(std::cmp::Ordering::Greater)
+                }) {
+                    failure_checks.push(failed_numeric_margin(
+                        &format!(
+                            "training_benefit_{}_seat_{}",
+                            seat.logical_input, seat.seat_index
+                        ),
+                        seat.improvement_lower_bound_db,
+                        policy.min_improvement_lower_bound_db,
+                        MarginBoundary::ExclusiveMinimum,
+                    ));
+                }
+            }
+            benefit.map_err(failed)?;
+        }
+        let peak = outputs
+            .iter()
+            .filter_map(|output| output.peak_dbfs)
+            .fold(f64::NEG_INFINITY, f64::max);
+        quality.temporal.available_headroom_db = peak.is_finite().then_some(-peak);
+        // Equal seat weighting, with actual delivered target errors; gain
+        // preservation remains a hard constraint above, not a score offset.
+        let score = configured_metrics.mean_post_db;
+        if !score.is_finite() {
+            return Err(failed("nonfinite final candidate score"));
+        }
+        let acoustic_score = score;
+        let score = physical_drive::candidate_score(
+            acoustic_score,
+            drive_utilization,
+            policy.physical_drive_weight,
+        )
+        .map_err(failed)?;
+        candidate
+            .metadata
+            .stage_outcomes
+            .retain(|stage| stage.stage != "final_candidate_objective");
+        candidate.metadata.stage_outcomes.push(StageOutcome {
+                stage: "final_candidate_objective".into(),
+                status: StageStatus::Applied,
+                checks: vec![StageCheck {
+                    id: "delivered_candidate_score".into(),
+                    kind: StageCheckKind::Quality,
+                    passed: true,
+                    observed: Some(score),
+                    limit: None,
+                    diagnostic: Some(serde_json::json!({
+                        "mean_seat_target_error_db": acoustic_score,
+                        "score_basis": "configured_routing_unprocessed_captures_v1",
+                        "configured_training_improvement_db": configured_metrics.training_improvement_db,
+                        "worst_declared_drive_utilization": drive_utilization,
+                        "physical_drive_weight": policy.physical_drive_weight,
+                        "scope": "historical selection-stage ranking; later pruning may change the graph; declared sampled steady-sine demand, not authenticated hardware capacity or perceptual benefit"
+                    }).to_string()),
+                }],
+                advisories: vec!["all_electrical_physical_and_seat_constraints_remain_hard_gates".into()],
+            });
+        record_final_electrical_stage(
+            &mut candidate,
+            &outputs,
+            policy,
+            format!(
+                "required_output_attenuation_db={attenuation:.9}; required_physical_attenuation_db={:.9}; mode={attenuation_mode}",
+                physical
+                    .values()
+                    .map(|value| value.attenuation_db)
+                    .fold(0.0_f64, f64::max)
+            ),
+        )?;
+        roomeq_playback::final_resources::bind_final_convolution_artifacts(&mut candidate, dir, store, fs)?;
+        refresh_final_reports(&mut candidate, config, fs, dir);
+        let epa_checks = epa::assess(&mut candidate, config);
+        if epa_checks.iter().any(|check| !check.passed) {
+            failure_checks.extend(epa_checks.into_iter().filter(|check| !check.passed));
+            return Err(failed(
+                "delivered frozen EPA spectral error regressed or is unavailable",
+            ));
+        }
+        sanity_check_result(&candidate)?;
+        let intact_full_correction =
+            strength == 1.0 && sub_strength == 1.0 && same_correction_kernels(original, &candidate);
+        let all_seats_improved = candidate
+            .metadata
+            .correction_acceptance
+            .as_ref()
+            .and_then(|report| report.acoustic_quality.as_ref())
+            .is_some_and(|quality| {
+                quality
+                    .final_seats
+                    .iter()
+                    .all(|seat| seat.improvement_lower_bound_db > 1e-6)
+            });
+        let residual_is_negligible = candidate
+            .metadata
+            .correction_acceptance
+            .as_ref()
+            .and_then(|report| report.acoustic_quality.as_ref())
+            .is_some_and(|quality| {
+                quality
+                    .final_seats
+                    .iter()
+                    .map(|seat| seat.post_weighted_rms_db)
+                    .sum::<f64>()
+                    / quality.final_seats.len().max(1) as f64
+                    <= 0.05
+            });
+        // An optional splice EQ must compete with its absence under the
+        // same final electrical and native-seat checks, even if the first
+        // complete candidate passes. Keep the existing shortcut otherwise.
+        stop_after_trial = !has_post_eq_alternative
+            && policy.physical_drive_weight == 0.0
+            && ((intact_full_correction && (all_seats_improved || !allow_role_refinement))
+                || residual_is_negligible);
+        Ok(score)
+    })();
+    if attempt.is_err() {
+        retain_failed_candidate_checks(&mut failure_checks, &candidate, &initial_stage_checks);
+    }
+    let trial_id = if let Some(index) = joint_trial {
+        joint_trials[index].id()
+    } else if drive_cut_db == 0.0 {
+        format!("correction_strength_{strength:.5}_sub_{sub_strength:.5}_{attenuation_mode}")
+    } else {
+        format!(
+            "correction_strength_{strength:.5}_sub_{sub_strength:.5}_{attenuation_mode}_drive_cut_{drive_cut_db:.5}"
+        )
+    };
+    let check = StageCheck {
+        id: if omit_post_eq {
+            format!("{trial_id}_without_post_eq")
+        } else {
+            trial_id
+        },
+        // Rejected alternatives are diagnostic search outcomes. The
+        // selected graph has separate enforced final safety evidence.
+        kind: StageCheckKind::Quality,
+        passed: attempt.is_ok(),
+        observed: attempt.as_ref().ok().copied(),
+        limit: None,
+        diagnostic: attempt.as_ref().err().map(|error| {
+            serde_json::json!({
+                "reason": error.to_string(),
+                "gate_checks": failure_checks,
+            })
+            .to_string()
+        }),
+    };
+    Ok(Some(EvaluatedTrial {
+        candidate: Some(candidate),
+        attempt,
+        check,
+        stop_after_trial,
+    }))
+}
+
+enum MarginBoundary {
+    Maximum,
+    ExclusiveMinimum,
+}
+
+fn failed_numeric_margin(
+    id: &str,
+    observed: f64,
+    limit: f64,
+    boundary: MarginBoundary,
+) -> StageCheck {
+    let observed = observed.is_finite().then_some(observed);
+    let limit = limit.is_finite().then_some(limit);
+    StageCheck {
+        id: id.into(),
+        kind: StageCheckKind::Quality,
+        passed: false,
+        observed,
+        limit,
+        diagnostic: Some(
+            serde_json::json!({
+            "comparison": match boundary {
+                MarginBoundary::Maximum => "at_most",
+                MarginBoundary::ExclusiveMinimum => "greater_than",
+            },
+                "unit": "dB",
+            "signed_violation_margin": observed.zip(limit).map(|(value, limit)| match boundary {
+                MarginBoundary::Maximum => value - limit,
+                MarginBoundary::ExclusiveMinimum => limit - value,
+            }),
+                "numeric_evidence_available": observed.is_some() && limit.is_some(),
+            })
+            .to_string(),
+        ),
+    }
+}
+
+/// Keep prior correction as an alternative to the optional routed splice EQ.
+fn without_common_post_eq(original: &RoomOptimizationResult) -> Option<RoomOptimizationResult> {
+    original
+        .metadata
+        .bass_management
+        .as_ref()?
+        .routing_graph
+        .as_ref()?;
+    let mut candidate = original.clone();
+    let mut changed = false;
+    for (name, chain) in &mut candidate.channels {
+        let before = chain.plugins.len();
+        chain.plugins.retain(|plugin| {
+            !(plugin.plugin_type == "eq"
+                && plugin
+                    .parameters
+                    .get("label")
+                    .and_then(serde_json::Value::as_str)
+                    == Some("post_eq")
+                && plugin
+                    .parameters
+                    .get("room_eq_stage")
+                    .and_then(serde_json::Value::as_str)
+                    == Some("pre_route"))
+        });
+        if chain.plugins.len() != before {
+            changed = true;
+            if let Some(channel) = candidate.channel_results.get_mut(name) {
+                // Routed mains retain this pass in their biquad summary. The
+                // preceding correction remains in its serialized plugins.
+                channel.biquads.clear();
+                // Evidence has no stage identity; retain it as history rather
+                // than claim its complete parameter set is still emitted.
+                for run in &mut channel.optimizer_evidence {
+                    run.selected_for_output = false;
+                }
+            }
+        }
+    }
+    changed.then_some(candidate)
+}
+
+/// Crossover residual plus responsible branches on a published baseline.
+///
+/// Collects per-role splice outcomes without aborting on the first
+/// rejection: a bad raw splice explains why no correction strength could
+/// succeed, while a clean one points at the seat/output violations instead.
+/// Unrouted graphs yield no entries; refused coherent timing and structural
+/// collection failures stay explicitly unassessed, never zero-filled.
+fn baseline_crossover_residuals(
+    baseline: &RoomOptimizationResult,
+    fs: f64,
+    dir: &Path,
+) -> Vec<String> {
+    let Some(bass) = baseline.metadata.bass_management.as_ref() else {
+        return Vec::new();
+    };
+    let Some(graph) = bass.routing_graph.as_ref() else {
+        return Vec::new();
+    };
+    if roomeq_playback::routed::crossover_timing_refused(bass.optimization.as_ref()) {
+        return vec!["crossover_residual_unassessed:coherent_timing_refused".to_string()];
+    }
+    match roomeq_playback::routed::collect_routed_splice_outcomes(
+        &baseline.channels,
+        &retained_fir_coeffs_by_channel(baseline),
+        graph,
+        bass.optimization.as_ref(),
+        fs,
+        dir,
+    ) {
+        Ok((_, outcomes)) => outcomes
+            .iter()
+            .map(|outcome: &roomeq_playback::routed::RoleSpliceOutcome| {
+                let mut branches: Vec<String> = graph
+                    .routes
+                    .iter()
+                    .filter(|route| route.source_channel == outcome.role)
+                    .map(|route| format!("{}->{}", route.source_channel, route.destination))
+                    .collect();
+                branches.sort();
+                branches.dedup();
+                match &outcome.assessed {
+                    Ok(evidence) => {
+                        let baseline = evidence
+                            .baseline_db
+                            .map(|db| format!(":baseline_db={db:.3}"))
+                            .unwrap_or_default();
+                        let improvement = evidence
+                            .improvement_db
+                            .map(|db| format!(":improvement_db={db:.3}"))
+                            .unwrap_or_default();
+                        format!(
+                            "crossover_residual:{}:underfill_db={:.3}:limit_db={:.3}:worst_hz={:.1}:reason={}{baseline}{improvement}:branches={}",
+                            outcome.role,
+                            evidence.final_db,
+                            evidence.limit_db,
+                            evidence.final_worst_frequency_hz,
+                            evidence.reason,
+                            branches.join("|"),
+                        )
+                    }
+                    Err(error) => format!(
+                        "crossover_residual:{}:unassessed:{error}:branches={}",
+                        outcome.role,
+                        branches.join("|"),
+                    ),
+                }
+            })
+            .collect(),
+        Err(error) => vec![format!("crossover_residual_unassessed:{error}")],
+    }
+}
+
+/// Require independent safety evidence before approving an attenuated baseline.
+fn baseline_has_safety_evidence(report: &roomeq_model::CorrectionAcceptanceReport) -> bool {
+    let (Some(policy), Some(score)) = (&report.runtime_policy, &report.acoustic_quality) else {
+        return false;
+    };
+    // Match the runtime acceptance implementation tolerance. This does not
+    // relax the independent sampled electrical output ceiling checked below.
+    const IMPLEMENTATION_TOLERANCE_DB: f64 = 0.5;
+    let temporal = &score.temporal;
+    score.finite
+        && score.max_boost_db.is_finite()
+        && score.max_boost_db <= policy.max_boost_db + IMPLEMENTATION_TOLERANCE_DB
+        && score.max_electrical_boost_db.is_some_and(|value| {
+            value.is_finite() && value <= policy.max_boost_db + IMPLEMENTATION_TOLERANCE_DB
+        })
+        && temporal.available_headroom_db.is_some_and(|value| {
+            value.is_finite()
+                && value >= policy.min_available_headroom_db - IMPLEMENTATION_TOLERANCE_DB
+        })
+        && temporal
+            .pre_ringing_audible_db
+            .is_some_and(|value| value.is_finite() && value <= policy.max_pre_ringing_audible_db)
+        && temporal.temporal_evidence_available
+        && temporal
+            .latency_ms
+            .is_some_and(|value| value.is_finite() && value <= policy.max_latency_ms)
+        && score
+            .induced_group_delay_rms_ms
+            .is_none_or(|value| value.is_finite() && value <= policy.max_induced_group_delay_rms_ms)
+        && !report.violations.iter().any(|violation| {
+            violation.contains("evidence_missing")
+                || violation.contains("insufficient")
+                || matches!(
+                    violation.as_str(),
+                    "acoustic_quality_non_finite"
+                        | "max_boost_limit_exceeded"
+                        | "headroom_limit_exceeded"
+                        | "pre_ringing_limit_exceeded"
+                        | "latency_limit_exceeded"
+                        | "induced_group_delay_limit_exceeded"
+                )
+        })
+}
+
+fn reconcile_configured_fallback_outcome(
+    result: &mut RoomOptimizationResult,
+    configured_processing: Option<&serde_json::Value>,
+    replay_passed: bool,
+) -> Result<()> {
+    let processing_changed = if let Some(reference) = configured_processing {
+        roomeq_playback::routed::processing_snapshot(result).map_err(failed)? != *reference
+    } else {
+        false
+    };
+    let Some(report) = result.metadata.correction_acceptance.as_mut() else {
+        return Ok(());
+    };
+    let residual_changed = report.acoustic_quality.as_ref().is_some_and(|quality| {
+        std::iter::once(&quality.training)
+            .chain(quality.held_out.as_ref())
+            .any(|partition| {
+                partition
+                    .configured_baseline
+                    .as_ref()
+                    .is_some_and(configured_reference_changed)
+            })
+    });
+    if (report.outcome == roomeq_model::RoomEqOutcome::Unchanged
+        && (processing_changed || residual_changed))
+        || (report.outcome == roomeq_model::RoomEqOutcome::SafeFallback && !replay_passed)
+    {
+        report.accepted = false;
+        report.decision = if replay_passed && baseline_has_safety_evidence(report) {
+            roomeq_model::CorrectionDecision::SafeFallback
+        } else {
+            roomeq_model::CorrectionDecision::Rejected
+        };
+        report
+            .violations
+            .push("configured_fallback_processing_changed".into());
+        report.violations.sort();
+        report.violations.dedup();
+        report.refresh_outcome();
+    }
+    Ok(())
+}
+
+/// Publish the exact correction-free graph used as the replay baseline.
+/// Missing measurements remain an evidence limitation, with no accepted claim.
+#[allow(clippy::too_many_arguments)]
+pub fn publish_baseline(
+    result: &mut RoomOptimizationResult,
+    captures: &[seat_replay::Capture],
+    held_out: &HashMap<String, Vec<Curve>>,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+    store: &dyn autoeq_artifacts::ArtifactStore,
+    reason: &str,
+    trials: Vec<StageCheck>,
+) -> Result<()> {
+    let comparison =
+        seat_replay::ConfiguredComparison::new(result, captures, held_out, config, fs, dir);
+    let mut structural = result.clone();
+    let structural_attempt = publish_baseline_with_alignment(
+        &mut structural,
+        captures,
+        held_out,
+        config,
+        fs,
+        dir,
+        store,
+        reason,
+        trials.clone(),
+        true,
+    );
+    let mut configured = comparison.fallback_graph();
+    let configured_processing = configured
+        .as_ref()
+        .ok()
+        .map(roomeq_playback::routed::processing_snapshot)
+        .transpose()
+        .map_err(failed)?;
+    let configured_attempt = configured
+        .as_mut()
+        .map_err(|error| error.to_string())
+        .and_then(|candidate| {
+            publish_baseline_with_alignment(
+                candidate, captures, held_out, config, fs, dir, store, reason, trials, true,
+            )
+            .and_then(|replay_passed| {
+                validate_configured_fallback_splices(candidate, config, fs, dir)
+                    .map(|()| replay_passed)
+            })
+            .map_err(|error| error.to_string())
+        });
+    comparison.attach(&mut structural);
+    reconcile_configured_fallback_outcome(
+        &mut structural,
+        configured_processing.as_ref(),
+        matches!(&structural_attempt, Ok(true)),
+    )?;
+    if let Ok(candidate) = &mut configured {
+        comparison.attach(candidate);
+        reconcile_configured_fallback_outcome(
+            candidate,
+            configured_processing.as_ref(),
+            matches!(&configured_attempt, Ok(true)),
+        )?;
+    }
+    let structural_score = structural_attempt
+        .as_ref()
+        .ok()
+        .and_then(|_| fallback_selection_score(&structural));
+    let configured_score = configured_attempt
+        .as_ref()
+        .ok()
+        .and_then(|_| configured.as_ref().ok().and_then(fallback_selection_score));
+    // Missing comparison or safety evidence cannot promote a configured graph.
+    // A qualified configured fallback can still rescue an unusable structural
+    // graph; otherwise both candidates compete on the same frozen reference.
+    let choose_configured = configured_attempt.is_ok()
+        && configured_score.is_some_and(|score| {
+            structural_attempt.is_err() || structural_score.is_none_or(|other| score + 1e-9 < other)
+        });
+    let check = StageCheck {
+        id: "configured_fallback_competition".into(),
+        kind: StageCheckKind::Quality,
+        observed: configured_score,
+        limit: structural_score,
+        passed: choose_configured,
+        diagnostic: Some(serde_json::json!({
+            "score_basis": "configured_routing_unprocessed_captures_v1",
+            "selected": if choose_configured { "configured_controls" } else { "optimized_structural_controls" },
+            "structural_error": structural_attempt.as_ref().err().map(ToString::to_string),
+            "configured_error": configured_attempt.err(),
+            "structural_gate_checks": structural.metadata.correction_acceptance.as_ref()
+                .map(roomeq_engine::quality::runtime_acceptance_failure_checks),
+            "configured_gate_checks": configured.as_ref().ok().and_then(|candidate| candidate.metadata.correction_acceptance.as_ref())
+                .map(roomeq_engine::quality::runtime_acceptance_failure_checks),
+            "configured_splice_checks": configured.as_ref().ok().and_then(|candidate| candidate.metadata.stage_outcomes.iter().rev()
+                .find(|stage| stage.stage == "configured_fallback_crossover_validation")).map(|stage| &stage.checks),
+        }).to_string()),
+    };
+    let source_refusals: Vec<_> = if choose_configured {
+        structural
+            .metadata
+            .stage_outcomes
+            .iter()
+            .filter(|stage| stage.stage == "final_correction_selection")
+            .flat_map(|stage| &stage.advisories)
+            .filter(|reason| reason.starts_with("baseline_quality_limit"))
+            .map(|reason| format!("source_candidate=optimized_structural_controls; {reason}"))
+            .collect()
+    } else {
+        Vec::new()
+    };
+    if choose_configured {
+        *result = configured?;
+    } else {
+        structural_attempt?;
+        *result = structural;
+    }
+    if let Some(stage) = result
+        .metadata
+        .stage_outcomes
+        .iter_mut()
+        .rev()
+        .find(|stage| stage.stage == "final_correction_selection")
+    {
+        // The selected configured fallback must not erase the native refusal
+        // of the structural candidate. Keep its explicit scope and budget.
+        for refusal in source_refusals {
+            if !stage.advisories.contains(&refusal) {
+                stage.advisories.push(refusal);
+            }
+        }
+        stage.checks.push(check);
+        stage.advisories.push(format!(
+            "fallback_controls={}",
+            if choose_configured {
+                "configured"
+            } else {
+                "optimized_structural"
+            }
+        ));
+    }
+    Ok(())
+}
+
+/// Check newly restored routing against the configured cancellation budget.
+fn validate_configured_fallback_splices(
+    result: &mut RoomOptimizationResult,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+) -> Result<()> {
+    let Some(bass) = result.metadata.bass_management.as_ref() else {
+        return Ok(());
+    };
+    let Some(graph) = bass.routing_graph.as_ref() else {
+        return Ok(());
+    };
+    let (_, outcomes) = roomeq_playback::routed::collect_routed_splice_outcomes(
+        &result.channels,
+        &retained_fir_coeffs_by_channel(result),
+        graph,
+        bass.optimization.as_ref(),
+        fs,
+        dir,
+    )?;
+    let checks: Vec<_> = outcomes
+        .into_iter()
+        .map(|outcome| {
+            let limit = config.optimizer.max_crossover_cancellation_db
+                + roomeq_model::CROSSOVER_CANCELLATION_TOLERANCE_DB;
+            let observed = outcome
+                .assessed
+                .as_ref()
+                .ok()
+                .map(|evidence| evidence.final_db);
+            StageCheck {
+                id: format!("configured_fallback_crossover:{}", outcome.role),
+                kind: StageCheckKind::Quality,
+                observed,
+                limit: Some(limit),
+                passed: observed.is_some_and(|value| value.is_finite() && value <= limit),
+                diagnostic: Some(
+                    serde_json::json!({
+                        "comparison": "at_most", "unit": "dB",
+                        "signed_violation_margin": observed.map(|value| value - limit),
+                        "evidence": outcome.assessed,
+                    })
+                    .to_string(),
+                ),
+            }
+        })
+        .collect();
+    let passed = !checks.is_empty() && checks.iter().all(|check| check.passed);
+    result.metadata.stage_outcomes.push(StageOutcome {
+        stage: "configured_fallback_crossover_validation".into(),
+        status: if passed {
+            StageStatus::Applied
+        } else {
+            StageStatus::Degraded
+        },
+        checks,
+        advisories: Vec::new(),
+    });
+    if !passed {
+        return Err(failed(
+            "configured fallback crossover cancellation or evidence exceeds the declared budget",
+        ));
+    }
+    Ok(())
+}
+
+/// Rank only complete, independently safe fallback evidence.
+fn fallback_selection_score(result: &RoomOptimizationResult) -> Option<f64> {
+    let report = result.metadata.correction_acceptance.as_ref()?;
+    if report.decision == roomeq_model::CorrectionDecision::Rejected
+        || !baseline_has_safety_evidence(report)
+    {
+        return None;
+    }
+    seat_replay::configured_selection_metrics(report)
+        .ok()
+        .map(|metrics| metrics.mean_post_db)
+}
+
+#[expect(
+    clippy::too_many_arguments,
+    reason = "One bounded retry preserves the established baseline publication inputs"
+)]
+fn publish_baseline_with_alignment(
+    result: &mut RoomOptimizationResult,
+    captures: &[seat_replay::Capture],
+    held_out: &HashMap<String, Vec<Curve>>,
+    config: &RoomConfig,
+    fs: f64,
+    dir: &Path,
+    store: &dyn autoeq_artifacts::ArtifactStore,
+    reason: &str,
+    mut trials: Vec<StageCheck>,
+    allow_alignment: bool,
+) -> Result<bool> {
+    // Record exactly which correction stages the structural restore is
+    // about to discard so the published fallback carries an explicit
+    // reversion record instead of silently dropping them.
+    let discarded_stages: Vec<String> = result
+        .channels
+        .iter()
+        .flat_map(|(name, chain)| {
+            let mut discarded = super::room_optimization_result::correction_stages(chain);
+            let mut after = chain.clone();
+            after
+                .plugins
+                .retain(|plugin| !super::room_optimization_result::is_baseline_correction(plugin));
+            for stage in super::room_optimization_result::correction_stages(&after) {
+                discarded.remove(&stage);
+            }
+            discarded
+                .into_iter()
+                .map(move |stage| format!("{name}:{}", stage.as_str()))
+        })
+        .collect();
+    let mut baseline = result.clone();
+    seat_replay::restore_structural_baseline(&mut baseline);
+    if trials.iter().any(|trial| {
+        trial
+            .diagnostic
+            .as_deref()
+            .is_some_and(|reason| reason.contains("correlated-bass efficiency regressed"))
+    }) {
+        // EQ strength cannot repair mutually cancelling route controls. Restore
+        // the fixed configured routes before judging/publishing the fallback.
+        seat_replay::restore_configured_bass_routes(&mut baseline, config)?;
+    }
+    // The discarded correction and its derived trims no longer describe this
+    // graph. Recompute the topology-owned trims from the structural candidate
+    // before rebuilding playback or measuring levels. Never retain a
+    // successful alignment report from a different candidate.
+    roomeq_playback::routed::recalibrate_post_dsp_levels(&mut baseline, config, fs, dir)?;
+    refresh_responses(&mut baseline, fs, dir)?;
+    let references = baseline
+        .channel_results
+        .iter()
+        .map(|(name, channel)| (name.clone(), channel.initial_curve.clone()))
+        .collect();
+    let (_, baseline_spread, baseline_band) =
+        final_role_level_alignment_gains(config, &baseline.deployed_source_curves, &references);
+    baseline
+        .metadata
+        .stage_outcomes
+        .retain(|stage| stage.stage != "structural_baseline_channel_alignment_reference");
+    baseline.metadata.stage_outcomes.push(StageOutcome {
+        stage: "structural_baseline_channel_alignment_reference".into(),
+        status: if baseline_spread.is_finite()
+            && baseline_spread <= FINAL_CHANNEL_LEVEL_TOLERANCE_DB
+        {
+            StageStatus::Applied
+        } else {
+            StageStatus::Degraded
+        },
+        checks: vec![StageCheck {
+            id: "structural_baseline_channel_level_spread_db".into(),
+            kind: StageCheckKind::Quality,
+            observed: baseline_spread.is_finite().then_some(baseline_spread),
+            limit: Some(FINAL_CHANNEL_LEVEL_TOLERANCE_DB),
+            passed: baseline_spread.is_finite()
+                && baseline_spread <= FINAL_CHANNEL_LEVEL_TOLERANCE_DB,
+            diagnostic: Some(
+                serde_json::to_string(&[baseline_band.0, baseline_band.1])
+                    .map_err(|error| failed(error.to_string()))?,
+            ),
+        }],
+        advisories: vec!["existing_room_channel_imbalance_is_not_correction_improvement".into()],
+    });
+    // Alignment is a candidate operation. A rejected correction must not make
+    // the structural fallback disappear merely because its own optional level
+    // alignment cannot pass the acoustic checks. Try it on a copy so a failed
+    // attempt cannot leave a partially modified fallback graph behind.
+    // The seat verification below compares the delivered graph against the
+    // pre-alignment structural graph, so freeze that reference first.
+    let frozen_baseline = baseline.clone();
+    let mut aligned = baseline.clone();
+    let mut alignment_applied = false;
+    let alignment = if !allow_alignment {
+        StageOutcome {
+            stage: "final_channel_level_alignment".into(),
+            status: StageStatus::Skipped,
+            checks: Vec::new(),
+            advisories: vec!["optional_alignment_removed_after_acoustic_rejection".into()],
+        }
+    } else {
+        match apply_final_channel_level_alignment(&mut aligned, config, fs, dir) {
+            Ok(outcome) if outcome.checks.iter().all(|check| check.passed) => {
+                alignment_applied = outcome.status == StageStatus::Applied;
+                baseline = aligned;
+                outcome
+            }
+            Ok(mut outcome) => {
+                outcome.status = StageStatus::Degraded;
+                outcome
+                    .advisories
+                    .push("structural_fallback_level_alignment_rejected".into());
+                outcome
+            }
+            Err(error @ AutoeqError::OptimizationFailed { .. }) => StageOutcome {
+                stage: "final_channel_level_alignment".into(),
+                status: StageStatus::Degraded,
+                advisories: vec![format!(
+                    "structural_fallback_level_alignment_rejected: {error}"
+                )],
+                checks: Vec::new(),
+            },
+            Err(error) => return Err(error),
+        }
+    };
+    baseline.metadata.stage_outcomes.retain(|stage| {
+        stage.stage != "final_channel_level_alignment"
+            && stage.stage != "channel_level_candidate_requires_final_refinement"
+            && stage.stage != "final_candidate_objective"
+    });
+    baseline.metadata.stage_outcomes.push(alignment);
+    let policy = &config.optimizer.finalization;
+    sub_output_limiter::install(&mut baseline, config, fs)?;
+    let outputs = roomeq_playback::electrical_headroom::assess_final_graph(
+        &baseline.to_dsp_chain_output(),
+        fs,
+        dir,
+        policy,
+    )?;
+    let protected = sub_output_limiter::protected_outputs(&baseline, policy)?;
+    let unprotected: Vec<_> = outputs
+        .iter()
+        .filter(|output| !protected.contains(&output.output))
+        .cloned()
+        .collect();
+    let physical = physical_drive::requirements(&baseline, config, fs, dir)?;
+    let required =
+        physical_drive::combined_attenuations(&unprotected, &physical, policy.output_ceiling_dbfs);
+    let attenuation = required.values().copied().fold(0.0_f64, f64::max);
+    attenuation_budget::check(&baseline, config, &required, None, "structural baseline")?;
+    if attenuation > 1e-6 || physical.values().any(|value| value.attenuation_db > 0.0) {
+        // A bass-bus overload must not attenuate unrelated physical mains.
+        // Recheck acoustic integration below rather than preserving it by
+        // silently lowering every programme input to the worst output's level.
+        install_output_attenuation_requirements(&mut baseline, &required)?;
+    }
+    verify_declared_physical_drive(&mut baseline, config, fs, dir)?;
+    refresh_responses(&mut baseline, fs, dir)?;
+    refresh_final_reports(&mut baseline, config, fs, dir);
+    let safety_budget_checks = output_safety_attenuation_budget_checks(&baseline, config)?;
+    let safety_budget_failure = output_safety_attenuation_failure(&safety_budget_checks);
+    let safety_budget_exceeded =
+        record_output_safety_attenuation_budget(&mut baseline, safety_budget_checks);
+    let delivered_policy = baseline
+        .metadata
+        .correction_acceptance
+        .as_ref()
+        .and_then(|report| report.runtime_policy.clone())
+        .map(|policy| room_optimization_result::policy_for_delivered_graph(&baseline, policy));
+    if let Some(report) = baseline.metadata.correction_acceptance.as_mut() {
+        report
+            .reverted_stages
+            .extend(discarded_stages.iter().cloned());
+        report.reverted_stages.sort();
+        report.reverted_stages.dedup();
+        // Candidate evidence must never be attached to the delivered fallback.
+        report.acoustic_quality = None;
+        report.realization_quality = None;
+        report.runtime_policy = delivered_policy;
+        report.violations.clear();
+        report.metrics.post_target_weighted_rms_db = report.metrics.pre_target_weighted_rms_db;
+        report.metrics.improvement_db = 0.0;
+        report.metrics.improvement_ratio = 0.0;
+        report.metrics.correction_rms_db = 0.0;
+        report.metrics.max_abs_correction_db = 0.0;
+    }
+    let replay = seat_replay::validate_candidate_final_seats(
+        &mut baseline,
+        &frozen_baseline,
+        captures,
+        held_out,
+        config,
+        fs,
+        dir,
+    );
+    let baseline_replay_passed = replay.is_ok();
+    if alignment_applied && matches!(&replay, Err(AutoeqError::OptimizationFailed { .. })) {
+        let report = baseline.metadata.correction_acceptance.as_ref();
+        let gate_checks = report
+            .map(roomeq_engine::quality::runtime_acceptance_failure_checks)
+            .unwrap_or_default();
+        trials.push(StageCheck {
+            id: "structural_baseline_optional_alignment_rejected".into(),
+            kind: StageCheckKind::Quality,
+            passed: false,
+            observed: None,
+            limit: None,
+            diagnostic: Some(serde_json::json!({
+                "reason": format!("optional alignment discarded; native replay rejected: {}", replay.as_ref().unwrap_err()),
+                "gate_checks": gate_checks,
+            }).to_string()),
+        });
+        return publish_baseline_with_alignment(
+            result, captures, held_out, config, fs, dir, store, reason, trials, false,
+        );
+    }
+    let mut advisories = vec![reason.to_string(), "structural_baseline_published".into()];
+    if attenuation > 1e-6 {
+        advisories.push(format!("baseline_safety_attenuation_db={attenuation:.6}"));
+    }
+    if safety_budget_exceeded {
+        advisories.push("baseline_exceeds_output_safety_attenuation_budget".into());
+    }
+    if let Err(error) = replay {
+        match error {
+            AutoeqError::InvalidMeasurement { .. }
+                if error.to_string().contains("insufficient")
+                    || error.to_string().contains("phase")
+                    || error.to_string().contains("no final-seat") =>
+            {
+                let evidence = format!("baseline_evidence_insufficient: {error}");
+                if let Some(report) = baseline.metadata.correction_acceptance.as_mut() {
+                    report.violations.push(evidence.clone());
+                }
+                advisories.push(evidence);
+            }
+            AutoeqError::OptimizationFailed { .. } => {
+                // A pre-existing room defect is not a correction regression.
+                advisories.push(format!("baseline_quality_limit: {error}"));
+            }
+            _ => return Err(error),
+        }
+    }
+    advisories.extend(baseline_crossover_residuals(&baseline, fs, dir));
+    if let Some(report) = baseline.metadata.correction_acceptance.as_mut() {
+        report.accepted = false;
+        let safe_fallback = !safety_budget_exceeded && baseline_has_safety_evidence(report);
+        if let Some(failure) = safety_budget_failure {
+            report
+                .violations
+                .push(format!("max_output_safety_attenuation_exceeded: {failure}"));
+        }
+        report.decision = if attenuation > 1e-6 || safety_budget_exceeded {
+            if attenuation > 1e-6 {
+                report
+                    .violations
+                    .push("baseline_requires_safety_attenuation".into());
+            }
+            if safety_budget_exceeded {
+                report
+                    .violations
+                    .push("baseline_exceeds_output_safety_attenuation_budget".into());
+            }
+            if safe_fallback {
+                roomeq_model::CorrectionDecision::SafeFallback
+            } else {
+                roomeq_model::CorrectionDecision::Rejected
+            }
+        } else if baseline_replay_passed
+            && safe_fallback
+            && report.acoustic_quality.as_ref().is_some_and(|score| {
+                score.correction_rms_db.abs() > 1e-6
+                    || score
+                        .final_seats
+                        .iter()
+                        .any(|seat| seat.improvement_db.abs() > 1e-6)
+                    || score
+                        .training
+                        .configured_baseline
+                        .as_ref()
+                        .is_some_and(configured_reference_changed)
+                    || score
+                        .held_out
+                        .as_ref()
+                        .and_then(|partition| partition.configured_baseline.as_ref())
+                        .is_some_and(configured_reference_changed)
+            })
+        {
+            // Optional structural alignment can change the delivered response
+            // even without electrical safety attenuation. Every replay gate
+            // passed, but this graph is not an unchanged identity result.
+            report
+                .violations
+                .push("baseline_structural_alignment_changes_response".into());
+            roomeq_model::CorrectionDecision::SafeFallback
+        } else {
+            roomeq_model::CorrectionDecision::IdentityFallback
+        };
+        report.violations.push(reason.to_string());
+        report.violations.sort();
+        report.violations.dedup();
+        report.refresh_outcome();
+    }
+    roomeq_playback::final_resources::bind_final_convolution_artifacts(&mut baseline, dir, store, fs)?;
+    let outputs = roomeq_playback::electrical_headroom::assess_final_graph(
+        &baseline.to_dsp_chain_output(),
+        fs,
+        dir,
+        policy,
+    )?;
+    let protected = sub_output_limiter::protected_outputs(&baseline, policy)?;
+    if outputs
+        .iter()
+        .filter(|output| !protected.contains(&output.output))
+        .any(|output| {
+            output
+                .peak_dbfs
+                .is_some_and(|peak| peak > policy.output_ceiling_dbfs + 1e-6)
+        })
+    {
+        return Err(failed(
+            "structural fallback exceeds the electrical output ceiling",
+        ));
+    }
+    record_final_electrical_stage(
+        &mut baseline,
+        &outputs,
+        policy,
+        format!(
+            "required_output_attenuation_db={attenuation:.9}; required_physical_attenuation_db={:.9}; mode=structural_fallback",
+            physical
+                .values()
+                .map(|value| value.attenuation_db)
+                .fold(0.0_f64, f64::max)
+        ),
+    )?;
+    sanity_check_result(&baseline)?;
+    baseline.metadata.stage_outcomes.push(StageOutcome {
+        stage: "final_correction_selection".into(),
+        status: StageStatus::Degraded,
+        advisories,
+        checks: trials,
+    });
+    // WP4a advisory on the published baseline too: the raw room's
+    // correlated-bass behavior explains what correction had to work with.
+    let mono_bass = seat_replay::correlated_bass_stage(&baseline, captures, config, fs, dir);
+    baseline.metadata.stage_outcomes.push(mono_bass);
+    *result = baseline;
+    Ok(baseline_replay_passed)
+}
+
+fn record_final_electrical_stage(
+    result: &mut RoomOptimizationResult,
+    outputs: &[roomeq_engine::quality::electrical_headroom::SampledElectricalOutputPeak],
+    policy: &roomeq_model::FinalizationConfig,
+    detail: String,
+) -> Result<()> {
+    let protected = sub_output_limiter::protected_outputs(result, policy)?;
+    result
+        .metadata
+        .stage_outcomes
+        .retain(|stage| stage.stage != "final_graph_sampled_electrical_headroom");
+    result.metadata.stage_outcomes.push(StageOutcome {
+        stage: "final_graph_sampled_electrical_headroom".into(),
+        status: StageStatus::Applied,
+        advisories: vec![
+            "enforced_independently_phased_sinusoidal_input_peaks".into(),
+            "sampled_sinusoidal_only_not_full_band_transient_or_native_certificate".into(),
+            if protected.is_empty() { "protection=static_linear".into() } else {
+                "protection=native_sub_output_limiter; acoustic_curves=small_signal; sample_peak_only; limiter_must_not_be_bypassed".into()
+            },
+            detail,
+        ],
+        checks: outputs
+            .iter()
+            .map(|output| if protected.contains(&output.output) {
+                StageCheck {
+                    id: format!("runtime_limiter_physical_output:{}", output.output),
+                    kind: StageCheckKind::Safety,
+                    passed: true,
+                    observed: Some(10.0_f64.powf(policy.output_ceiling_dbfs.min(-1.0) / 20.0)),
+                    limit: Some(10.0_f64.powf(policy.output_ceiling_dbfs / 20.0)),
+                    diagnostic: Some(serde_json::json!({
+                        "protection": "native_runtime_sample_peak_limiter",
+                        "linearized_pre_limiter": output,
+                        "threshold_dbfs": policy.output_ceiling_dbfs.min(-1.0),
+                        "lookahead_ms": roomeq_engine::runtime_limiter::LOOKAHEAD_MS,
+                        "acoustic_response": "small_signal_only"
+                    }).to_string()),
+                }
+            } else { StageCheck {
+                id: format!("sampled_physical_output:{}", output.output),
+                kind: StageCheckKind::Safety,
+                passed: output
+                    .peak_dbfs
+                    .is_none_or(|peak| peak <= policy.output_ceiling_dbfs + 1e-6),
+                observed: Some(output.peak_amplitude),
+                limit: Some(10.0_f64.powf(policy.output_ceiling_dbfs / 20.0)),
+                diagnostic: Some(
+                    serde_json::to_string(output).expect("finite electrical evidence"),
+                ),
+            } })
+            .collect(),
+    });
+    Ok(())
+}
