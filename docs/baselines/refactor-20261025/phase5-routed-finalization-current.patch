+"""Regression controls for coverage responsibility after crate extraction."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from scripts.roomeq_coverage_ownership import (PACKAGES, ROOM_PACKAGES, ADDITIONAL_PACKAGES, CANONICAL_FIXTURE, DUPLICATE_FIXTURES, included, selected_packages, duplicate_fixtures, subsystem_matches)
+from scripts.check_roomeq_subsystem_coverage import main, THRESHOLDS
+
+
+class ExtractedCoverageOwnershipTests(unittest.TestCase):
+    def test_all_extracted_owners_count_but_duplicate_fixtures_do_not(self):
+        for owner in ADDITIONAL_PACKAGES:
+            self.assertTrue(included('/workspace/crates/'+owner+'/src/lib.rs'))
+        self.assertTrue(included('/workspace/'+CANONICAL_FIXTURE))
+        for duplicate in DUPLICATE_FIXTURES:
+            self.assertFalse(included('/workspace/'+duplicate))
+
+    def test_original_and_extracted_package_sets_fail_closed(self):
+        self.assertEqual(set(selected_packages(set(ROOM_PACKAGES[:-1])|{'autoeq'})),set(ROOM_PACKAGES[:-1]))
+        names=set(PACKAGES)|set(ADDITIONAL_PACKAGES)|{'autoeq-cli','roomeq-cli','roomeq-qa','roomeq-synthetic'}
+        self.assertEqual(set(selected_packages(names)),set(PACKAGES)|set(ADDITIONAL_PACKAGES))
+        for broken in [names-{'roomeq-quality'}, names|{'roomeq-unmapped-owner'}]:
+            with self.assertRaises(ValueError):selected_packages(broken)
+
+    def test_subsystem_floors_follow_original_responsibility(self):
+        room='crates/roomeq-workflow/src/room_optimization/'
+        routed='crates/roomeq-workflow/src/topology/'
+        for name in ['assessment.rs','assessment/timing.rs','level_alignment.rs','physical_fir.rs','parallel_timing.rs']:
+            self.assertTrue(subsystem_matches('/workspace/crates/roomeq-playback/src/'+name,room))
+        self.assertTrue(subsystem_matches('/workspace/crates/roomeq-finalization/src/room_optimization/finalization.rs',room))
+        self.assertTrue(subsystem_matches('/workspace/crates/roomeq-routed/src/topology/home_cinema.rs',routed))
+        self.assertTrue(subsystem_matches('/workspace/crates/roomeq-playback/src/routed.rs',routed))
+        for name in ['final_ledger/snapshot.rs','eq.rs','multiseat_channel.rs']:
+            self.assertFalse(subsystem_matches('/workspace/crates/roomeq-playback/src/'+name,routed))
+            self.assertFalse(subsystem_matches('/workspace/crates/roomeq-playback/src/'+name,room))
+
+    def test_uncovered_moved_code_cannot_escape_existing_floors(self):
+        originals=['roomeq-quality/src/lib.rs','roomeq-engine/src/eq/optimize.rs','roomeq-workflow/src/room_optimization.rs','roomeq-workflow/src/topology.rs']
+        files=[{'filename':'/workspace/crates/'+p,'summary':{'lines':{'count':100,'covered':100}}} for p in originals]
+        with tempfile.TemporaryDirectory(dir='/Volumes/home_tmp/tmp') as temp:
+            path=Path(temp)/'coverage.json'
+            for moved in ['roomeq-playback/src/assessment.rs','roomeq-finalization/src/room_optimization/finalization.rs','roomeq-routed/src/topology/home_cinema.rs','roomeq-playback/src/routed.rs']:
+                path.write_text(json.dumps({'data':[{'files':files+[{'filename':'/workspace/crates/'+moved,'summary':{'lines':{'count':100,'covered':0}}}]}]}))
+                with patch('sys.argv',['checker',str(path)]), contextlib.redirect_stdout(io.StringIO()):
+                    self.assertEqual(main(),1,moved)
+        self.assertEqual(list(THRESHOLDS.values()),[90.0,85.0,80.0,75.0])
+
+    def test_duplicate_exclusions_require_identical_test_only_copies(self):
+        with tempfile.TemporaryDirectory(dir='/Volumes/home_tmp/tmp') as temp:
+            root=Path(temp)
+            for relative in [CANONICAL_FIXTURE,*DUPLICATE_FIXTURES]:
+                p=root/relative;p.parent.mkdir(parents=True,exist_ok=True);p.write_text('fn fixture() {}\n');p.with_name('lib.rs').write_text('#[cfg(test)]\nmod test_fixtures;\n')
+            self.assertEqual(duplicate_fixtures(root),list(DUPLICATE_FIXTURES))
+            changed=root/DUPLICATE_FIXTURES[0];changed.write_text('fn hidden_production() {}\n')
+            with self.assertRaisesRegex(ValueError,'exact canonical copy'):duplicate_fixtures(root)
+            changed.write_bytes((root/CANONICAL_FIXTURE).read_bytes());changed.with_name('lib.rs').write_text('mod test_fixtures;\n')
+            with self.assertRaisesRegex(ValueError,'test-only'):duplicate_fixtures(root)
+
+
+if __name__=='__main__':unittest.main()
