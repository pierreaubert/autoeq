-                    == Some("excursion_protection")
-        })
-        .filter_map(|plugin| plugin.parameters.get("filters"))
-        .filter_map(|filters| filters.as_array())
-        .flatten()
-        .filter_map(|filter| filter.get("freq").and_then(|v| v.as_f64()))
-        .filter(|freq| freq.is_finite() && *freq > 0.0)
-        .reduce(f64::max)
